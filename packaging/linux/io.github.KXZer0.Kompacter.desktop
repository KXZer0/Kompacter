[Desktop Entry]
Type=Application
Name=Kompacter
Comment=Shrink files to fit an upload limit
Exec=kompacter %F
Icon=io.github.KXZer0.Kompacter
Terminal=false
Categories=AudioVideo;
MimeType=video/mp4;video/webm;video/x-matroska;video/quicktime;image/jpeg;image/png;image/webp;image/gif;audio/mpeg;audio/flac;audio/wav;application/pdf;
StartupNotify=true
StartupWMClass=io.github.KXZer0.Kompacter
Actions=ChooseFiles;Quit;

[Desktop Action ChooseFiles]
Name=Choose files
Exec=kompacter --choose-files

[Desktop Action Quit]
Name=Quit Kompacter
Exec=kompacter --quit
