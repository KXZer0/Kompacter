// The Settings screen. Its values and actions live in the `Prefs` global, which Rust fills
// and listens to (see `sync_settings` in src/app/mod.rs); add a setting here and there.

import { Theme, Fx, Icon, AppLogo, Btn, IconBtn, Switch, Seg, Dropdown } from "theme.slint";
import { Icons } from "icons.slint";
import { FeatureDemo } from "demo.slint";
import { CompressionPreference } from "compression-preference.slint";

export struct PresetItem {
    name: string,
    note: string,
    size: string,
    brand: string,
}

export global Prefs {
    in property <int> style-index;
    in property <int> theme-index;
    in property <[string]> theme-options: ["System", "Light", "Dark"];
    in property <int> output-index;
    in property <string> output-dir;
    in property <bool> gpu;
    in property <bool> windows-integration;
    /// "Replace the original" (needs a Recycle Bin / Trash) and what it's called here.
    in property <bool> replace-available;
    in property <string> trash-name: "Recycle Bin";
    in property <bool> auto-update;
    in property <bool> auto-hide;
    in property <string> auto-hide-error;
    in property <bool> start-with-windows;
    in property <bool> tray-pinned;
    in property <bool> explorer-menu;
    in property <string> tray-note;
    in property <int> custom-mb;
    in property <int> compression-preference: 1;
    in property <int> video-index;
    in property <int> audio-index;
    in property <int> image-index;
    in property <int> archive-index;
    /// What each format is under the current preference (shown while it is followed).
    in property <string> video-auto: "H.264";
    in property <string> audio-auto: "MP3";
    in property <string> image-auto: "Auto";
    in property <string> archive-auto: "Zip";
    in property <[string]> shortcut-options: ["Off", "Ctrl+Alt+K", "Ctrl+Shift+K", "Ctrl+Shift+Space"];
    in property <int> shortcut-index;
    in property <bool> shortcut-taken;
    in property <bool> global-shortcut-available;
    in property <bool> paste-guard-available;
    in property <bool> watch-copies-available;
    /// Why copies can't be noticed in this session (empty: they can).
    in property <string> watch-copies-note;
    in property <bool> watch-folders-available;
    in property <bool> paste-guard;
    in property <bool> watch-copies;
    in property <bool> watch-folders;
    in property <[string]> clip-folders;

    callback set-style(int);
    callback set-theme(int);
    callback set-output(int);
    callback choose-folder();
    callback open-outputs();
    callback set-gpu(bool);
    callback set-auto-update(bool);
    callback set-auto-hide(bool);
    callback set-start(bool);
    callback set-tray-pinned(bool);
    callback set-explorer-menu(bool);
    callback set-custom-mb(int);
    callback set-compression-preference(int);
    callback set-video(int);
    callback set-audio(int);
    callback set-image(int);
    callback set-archive(int);
    /// Every format back to "Follow preference".
    callback reset-formats();
    callback set-shortcut(int);
    callback set-paste-guard(bool);
    callback set-watch-copies(bool);
    callback set-watch-folders(bool);
    callback add-clip-folder();
    callback remove-clip-folder(int);
}

/// A group row in settings: label + optional small text + something on the right.
export component Cell inherits Rectangle {
    in property <string> label;
    in property <string> small;
    in property <bool> first;
    in property <bool> shown: true;
    in property <bool> clickable;
    /// The pointer is on the row (not on what sits on top of it, like its switch).
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    min-height: root.shown ? (root.small != "" ? 56px : 44px) : 0px;
    max-height: root.shown ? 10000px : 0px;
    visible: root.shown;
    background: ta.has-hover && root.clickable ? Theme.fill : transparent;
    animate background { duration: 120ms; }
    if !root.first: Rectangle {
        x: 12px;
        y: 0;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.sep;
    }
    // Always on, so rows that only hold a switch still know they're hovered.
    ta := TouchArea {
        mouse-cursor: root.clickable ? pointer : default;
        clicked => {
            if (root.clickable) {
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: 14px;
                color: Theme.label;
                overflow: elide;
            }
            if root.small != "": Text {
                text: root.small;
                font-size: 12px;
                color: Theme.label-2;
                overflow: elide;
            }
        }
        @children
    }
}

export component Group inherits Rectangle {
    border-radius: 12px;
    background: Theme.group;
    clip: true;
    VerticalLayout {
        @children
    }
}

component GroupTitle inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.label-2;
}

component Check inherits Rectangle {
    in property <bool> on;
    width: 18px;
    Icon {
        d: Icons.check;
        color: Theme.accent-text;
        opacity: root.on ? 1 : 0;
        animate opacity { duration: 120ms; }
    }
}

/// Round − / + button. Click steps once; hold repeats, speeding up after a moment.
component StepBtn inherits Rectangle {
    in property <string> icon;
    callback step(int);
    property <int> ticks;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: ta.pressed ? Theme.fill-hover : ta.has-hover ? Theme.fill-hover : Theme.fill;
    animate background { duration: 100ms; }
    transform-scale: ta.pressed ? 0.9 : 1;
    animate transform-scale { duration: 200ms; easing: ease-out-back; }
    Icon {
        d: root.icon;
        size: 16px;
        color: Theme.label;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.ticks = 0;
                root.step(1);
            }
        }
    }
    Timer {
        interval: root.ticks == 0 ? 420ms : 60ms;
        running: ta.pressed;
        triggered => {
            root.ticks += 1;
            root.step(root.ticks > 20 ? 5 : 1);
        }
    }
}

export component SettingsView inherits Rectangle {
    in property <[PresetItem]> presets;
    in property <int> preset-index;
    callback select-preset(int);
    callback close-settings();
    /// The window is open (the hover preview only plays then).
    in property <bool> live: true;
    width: 360px;
    height: 600px;

    // Hover previews for the three automatic rows: rest the pointer on one for a moment
    // and a card shows what it does, like a tooltip. 0 copy, 1 paste guard, 2 clips.
    property <int> hover-row: copy-cell.hovered || copy-switch.hovered ? 0
        : paste-cell.hovered || paste-switch.hovered ? 1
        : clip-cell.hovered || clip-switch.hovered ? 2 : -1;
    property <bool> preview-on;
    // Formats set to something other than "Follow preference".
    property <int> overrides: (Prefs.video-index != 0 ? 1 : 0) + (Prefs.audio-index != 0 ? 1 : 0)
        + (Prefs.image-index != 0 ? 1 : 0) + (Prefs.archive-index != 0 ? 1 : 0);
    // Which row the card is for; kept while it fades out.
    property <int> preview-row;
    // How long the pointer has rested, in 110 ms steps; the card shows after five. A new
    // row, or a scroll, hides it and starts the count again. (Counting, because a Timer
    // that is restarted by hand keeps going after its `running` turns false.)
    property <int> preview-wait;
    function preview-reset() {
        root.preview-on = false;
        root.preview-wait = 0;
    }
    changed hover-row => { root.preview-reset(); }
    Timer {
        interval: 110ms;
        running: root.hover-row >= 0 && !root.preview-on && root.live;
        triggered => {
            root.preview-wait += 1;
            if (root.preview-wait >= 5) {
                root.preview-row = root.hover-row;
                root.preview-on = true;
            }
        }
    }
    IconBtn {
        x: 8px;
        y: 14px;
        icon: Icons.back;
        clicked => { root.close-settings(); }
    }
    Text {
        x: 48px;
        y: 12px;
        height: 36px;
        text: "Settings";
        font-size: 19px;
        font-weight: 650;
        color: Theme.label;
        vertical-alignment: center;
    }
    settings-scroll := Flickable {
        x: 0;
        y: 54px;
        width: 360px;
        height: 546px;
        changed content-y => { root.preview-reset(); }
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
            spacing: 6px;

            GroupTitle { text: "TARGET"; }
            Group {
                for p[i] in root.presets: Cell {
                    label: p.name;
                    first: i == 0;
                    clickable: true;
                    clicked => { root.select-preset(i); }
                    AppLogo {
                        brand: p.brand;
                        y: (parent.height - self.height) / 2;
                    }
                    // Custom limit: − [ 50 MB ] +. Type a number, or click / hold the
                    // buttons. Touching any of it picks Custom.
                    if p.brand == "custom": VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                        spacing: 6px;
                        StepBtn {
                            icon: "M7 12h10";
                            step(n) => {
                                root.select-preset(i);
                                Prefs.set-custom-mb(Math.max(1, Prefs.custom-mb - n));
                            }
                        }
                        Rectangle {
                            width: 76px;
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.fill;
                            border-width: 1px;
                            border-color: mb-field.has-focus ? Theme.accent : transparent;
                            animate border-color { duration: 120ms; }
                            // Rust may clamp the value; keep the box showing what's saved.
                            property <int> saved: Prefs.custom-mb;
                            changed saved => {
                                if (!mb-field.has-focus || mb-field.text.to-float() != self.saved) {
                                    mb-field.text = self.saved;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 3px;
                                mb-field := TextInput {
                                    text: Prefs.custom-mb;
                                    input-type: number;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: Theme.label;
                                    font-size: 14px;
                                    font-weight: 600;
                                    single-line: true;
                                    changed has-focus => {
                                        if (self.has-focus) {
                                            root.select-preset(i);
                                        } else {
                                            self.text = Prefs.custom-mb;
                                        }
                                    }
                                    accepted => {
                                        if (self.text.to-float() >= 1) {
                                            Prefs.set-custom-mb(self.text.to-float());
                                        }
                                        self.text = Prefs.custom-mb;
                                    }
                                    edited => {
                                        if (self.text.is-float() && self.text.to-float() >= 1) {
                                            Prefs.set-custom-mb(self.text.to-float());
                                        }
                                    }
                                }
                                Text {
                                    text: "MB";
                                    font-size: 13px;
                                    color: Theme.label-2;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        StepBtn {
                            icon: "M12 7v10M7 12h10";
                            step(n) => {
                                root.select-preset(i);
                                Prefs.set-custom-mb(Prefs.custom-mb + n);
                            }
                        }
                    }
                    }
                    if p.brand != "custom": Text {
                        text: p.size;
                        font-size: 14px;
                        color: Theme.label-2;
                        vertical-alignment: center;
                    }
                    Check { on: i == root.preset-index; }
                }
            }

            GroupTitle { text: "STYLE"; }
            Seg {
                options: ["Kompacter", "Discord"];
                index: Prefs.style-index;
                picked(i) => { Prefs.set-style(i); }
            }
            Seg {
                options: Prefs.theme-options;
                index: Prefs.theme-index;
                picked(i) => { Prefs.set-theme(i); }
            }

            GroupTitle { text: "SAVE TO"; }
            Group {
                Cell {
                    label: "Kompacter folder";
                    small: "Deleted after 7 days";
                    first: true;
                    clickable: true;
                    clicked => { Prefs.set-output(0); }
                    Btn {
                        text: "Open";
                        plain: true;
                        y: (parent.height - self.height) / 2;
                        clicked => { Prefs.open-outputs(); }
                    }
                    Check { on: Prefs.output-index == 0; }
                }
                Cell {
                    label: "Next to the original";
                    clickable: true;
                    clicked => { Prefs.set-output(1); }
                    Check { on: Prefs.output-index == 1; }
                }
                Cell {
                    label: "Pick a folder";
                    small: Prefs.output-dir;
                    clickable: true;
                    clicked => { Prefs.set-output(2); }
                    Btn {
                        text: "Choose…";
                        plain: true;
                        y: (parent.height - self.height) / 2;
                        clicked => { Prefs.choose-folder(); }
                    }
                    Check { on: Prefs.output-index == 2; }
                }
                if Prefs.replace-available: Cell {
                    label: "Replace the original";
                    small: "Original goes to the \{Prefs.trash-name}";
                    clickable: true;
                    clicked => { Prefs.set-output(3); }
                    Check { on: Prefs.output-index == 3; }
                }
            }

            GroupTitle { text: "COMPRESSION PREFERENCE"; }
            CompressionPreference {
                index: Prefs.compression-preference;
                picked(i) => { Prefs.set-compression-preference(i); }
                escaped => { root.close-settings(); }
                changed has-focus => {
                    if (self.has-focus) {
                        let top = self.absolute-position.y - settings-scroll.absolute-position.y;
                        let bottom = top + self.height - settings-scroll.height;
                        if (top < 0px) {
                            settings-scroll.content-y -= top;
                        } else if (bottom > 0px) {
                            settings-scroll.content-y -= bottom;
                        }
                    }
                }
            }

            // An override ignores the preference above, so each row and the title say so.
            GroupTitle {
                text: root.overrides == 0 ? "FORMATS" : root.overrides == 1 ? "FORMATS · 1 OVERRIDE"
                    : "FORMATS · \{root.overrides} OVERRIDES";
            }
            Group {
                Cell {
                    label: "Video";
                    small: Prefs.video-index == 0 ? "From preference: \{Prefs.video-auto}"
                        : Prefs.video-index == 1 ? "Override · Plays on more devices"
                        : Prefs.video-index == 2 ? "Override · Smaller files"
                        : "Override · More detail at the same size";
                    first: true;
                    Dropdown {
                        options: ["Follow preference", "H.264", "H.265", "AV1"];
                        notes: [Prefs.video-auto, "Plays on more devices", "Check recipient support", "Check recipient support"];
                        index: Prefs.video-index;
                        y: (parent.height - self.height) / 2;
                        picked(i) => { Prefs.set-video(i); }
                    }
                }
                Cell {
                    label: "Audio";
                    small: Prefs.audio-index == 0 ? "From preference: \{Prefs.audio-auto}"
                        : Prefs.audio-index == 1 ? "Override · MP3, or Opus for tight limits"
                        : Prefs.audio-index == 2 ? "Override · Plays on more devices"
                        : "Override · Better sound at the same size";
                    Dropdown {
                        options: ["Follow preference", "Auto", "MP3", "Opus"];
                        index: Prefs.audio-index;
                        y: (parent.height - self.height) / 2;
                        picked(i) => { Prefs.set-audio(i); }
                    }
                }
                Cell {
                    label: "Images";
                    small: Prefs.image-index == 0 ? "From preference: \{Prefs.image-auto}"
                        : Prefs.image-index == 1 ? "Override · Lossless first"
                        : Prefs.image-index == 2 ? "Override · Opens on more devices"
                        : "Override · Keeps transparency";
                    Dropdown {
                        options: ["Follow preference", "Auto", "JPEG", "WebP"];
                        index: Prefs.image-index;
                        y: (parent.height - self.height) / 2;
                        picked(i) => { Prefs.set-image(i); }
                    }
                }
                Cell {
                    label: "Folders & files";
                    small: Prefs.archive-index == 0 ? "From preference: \{Prefs.archive-auto}"
                        : Prefs.archive-index == 1 ? "Override · Opens on more devices"
                        : "Override · Needs Windows 11 or 7-Zip";
                    Dropdown {
                        options: ["Follow preference", "Zip", "7z"];
                        index: Prefs.archive-index;
                        y: (parent.height - self.height) / 2;
                        picked(i) => { Prefs.set-archive(i); }
                    }
                }
                if root.overrides > 0: Cell {
                    label: "Follow preference for all";
                    small: "Clear the overrides above";
                    clickable: true;
                    clicked => { Prefs.reset-formats(); }
                }
            }

            // Things Kompacter does without being opened. All off except the shortcut.
            if Prefs.global-shortcut-available || Prefs.watch-copies-available
                || Prefs.paste-guard-available || Prefs.watch-folders-available: GroupTitle { text: "AUTOMATIC"; }
            Group {
                if Prefs.global-shortcut-available: Cell {
                    label: "Shortcut";
                    small: Prefs.shortcut-taken ? "Used by another app, pick another"
                        : Prefs.shortcut-index == 0 ? "" : "Compress what you copied";
                    first: true;
                    Dropdown {
                        options: Prefs.shortcut-options;
                        index: Prefs.shortcut-index;
                        y: (parent.height - self.height) / 2;
                        picked(i) => { Prefs.set-shortcut(i); }
                    }
                }
                copy-cell := Cell {
                    shown: Prefs.watch-copies-available;
                    first: !Prefs.global-shortcut-available;
                    label: "When I copy a big file";
                    small: Prefs.watch-copies-note != "" ? Prefs.watch-copies-note : "A small bar offers to shrink it";
                    copy-switch := Switch {
                        checked: Prefs.watch-copies && Prefs.watch-copies-note == "";
                        enabled: Prefs.watch-copies-note == "";
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-watch-copies(on); }
                    }
                }
                paste-cell := Cell {
                    shown: Prefs.paste-guard-available;
                    first: !Prefs.global-shortcut-available && !Prefs.watch-copies-available;
                    label: "When I paste into a chat";
                    small: "Asks first in Discord, Slack and more";
                    paste-switch := Switch {
                        checked: Prefs.paste-guard;
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-paste-guard(on); }
                    }
                }
                clip-cell := Cell {
                    shown: Prefs.watch-folders-available;
                    first: !Prefs.global-shortcut-available && !Prefs.watch-copies-available && !Prefs.paste-guard-available;
                    label: "When I save a game clip";
                    small: "Shrinks new clips on their own";
                    clip-switch := Switch {
                        checked: Prefs.watch-folders;
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-watch-folders(on); }
                    }
                }
                if Prefs.watch-folders-available && Prefs.watch-folders: VerticalLayout {
                    for f[i] in Prefs.clip-folders: Cell {
                        label: f;
                        IconBtn {
                            icon: Icons.x;
                            y: (parent.height - self.height) / 2;
                            clicked => { Prefs.remove-clip-folder(i); }
                        }
                    }
                    Cell {
                        label: "Add folder…";
                        clickable: true;
                        clicked => { Prefs.add-clip-folder(); }
                        Icon {
                            d: "M12 6v12M6 12h12";
                            size: 16px;
                            color: Theme.accent-text;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            GroupTitle { text: "GENERAL"; }
            Group {
                Cell {
                    label: "GPU encoding";
                    small: Prefs.compression-preference == 2 ? "Efficiency uses software encoding" : "";
                    first: true;
                    Switch {
                        checked: Prefs.gpu && Prefs.compression-preference != 2;
                        enabled: Prefs.compression-preference != 2;
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-gpu(on); }
                    }
                }
                Cell {
                    label: "Auto-hide";
                    small: Prefs.auto-hide-error;
                    Switch {
                        checked: Prefs.auto-hide;
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-auto-hide(on); }
                    }
                }
                if Prefs.windows-integration: Cell {
                    label: "Start with Windows";
                    Switch {
                        checked: Prefs.start-with-windows;
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-start(on); }
                    }
                }
                if Prefs.windows-integration: Cell {
                    label: "Right-click menu";
                    small: "“Kompact” on files and folders in Explorer";
                    Switch {
                        checked: Prefs.explorer-menu;
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-explorer-menu(on); }
                    }
                }
                if Prefs.windows-integration: Cell {
                    label: "Install updates";
                    small: "Checked daily, installed on restart";
                    Switch {
                        checked: Prefs.auto-update;
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-auto-update(on); }
                    }
                }
                if Prefs.windows-integration: Cell {
                    label: "Keep tray icon visible";
                    small: Prefs.tray-note != "" ? Prefs.tray-note : "Next to the clock, not in the ^ menu";
                    Switch {
                        checked: Prefs.tray-pinned;
                        y: (parent.height - self.height) / 2;
                        toggled(on) => { Prefs.set-tray-pinned(on); }
                    }
                }
            }
        }
    }

    // The preview card. It sits up here, over the list, so the list's clipping can't cut
    // it off, and it has nothing to click, so the row's switch still works. Below the row
    // when it fits, above it otherwise.
    property <length> row-y: (root.preview-row == 0 ? copy-cell.absolute-position.y
        : root.preview-row == 1 ? paste-cell.absolute-position.y
        : clip-cell.absolute-position.y) - root.absolute-position.y;
    property <bool> preview-above: root.row-y + copy-cell.height + 6px + preview.height > root.height - 8px;
    preview := Rectangle {
        x: 48px;
        y: root.preview-above ? root.row-y - 6px - self.height : root.row-y + copy-cell.height + 6px;
        width: 264px;
        height: preview-col.preferred-height;
        border-radius: 12px;
        background: Theme.pop;
        border-width: 1px;
        border-color: Theme.pop-border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 5px;
        drop-shadow-color: Theme.shadow;
        opacity: root.preview-on ? 1 : 0;
        animate opacity { duration: Fx.rich ? 150ms : 0ms; easing: ease-out; }
        transform-origin: { x: self.width / 2, y: root.preview-above ? self.height : 0 };
        transform-scale: root.preview-on || !Fx.rich ? 1 : 0.96;
        animate transform-scale { duration: Fx.rich ? 150ms : 0ms; easing: ease-out; }
        visible: self.opacity > 0;
        preview-col := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            FeatureDemo {
                width: 240px;
                height: 140px;
                feature: root.preview-row;
                playing: root.preview-on && root.live;
            }
            Text {
                text: root.preview-row == 0 ? "Copy a file that's too big to send, and a small bar offers to shrink it."
                    : root.preview-row == 1 ? "Paste a too-big file into Discord, Slack, WhatsApp, Telegram or Signal, and Kompacter holds it back and asks to shrink it to that app's limit."
                    : "New game clips are shrunk on their own and copied, ready to paste.";
                font-size: 12px;
                color: Theme.label;
                wrap: word-wrap;
            }
        }
    }
}
