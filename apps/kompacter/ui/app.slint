// The Kompacter flyout: a calm 360×472 card; the trimmer and settings are taller.
// Rust owns the logic (src/main.rs) and sets the properties below; this file only draws.
//
// With GPU drawing the window is see-through and the card floats in it: big rounded
// corners, soft shadow, grows up out of the taskbar and folds back down. Without (Low-memory
// mode, or no GPU) the card fills a plain window and Rust slides the window in and out.

import { Theme, Fx, Icon, AppLogo, Btn, IconBtn, Kbd, Switch, Seg, Appear, Tip, Dropdown } from "theme.slint";
import { Icons } from "icons.slint";
import { Mood, Blob, DropZone, Press, Sparks } from "stage.slint";
import { Prefs, SettingsView, PresetItem } from "settings.slint";

export { Theme, Fx, Prefs, PresetItem }

export enum View { idle, reading, big, trim, busy, done, error, settings, quick }

/// One line of a before → after list (a folder's tree, or a video's stats).
export struct DiffRow {
    depth: int,
    /// "dir", "file", or "" (stat line)
    icon: string,
    label: string,
    before: string,
    after: string,
    changed: bool,
}

/// One line in the trimmer's quality details.
export struct DetailRow {
    label: string,
    value: string,
}


/// The tray icon (left click opens, right click shows the menu).
export component Tray inherits SystemTrayIcon {
    callback open();
    callback open-folder();
    callback quit();
    in property <string> tip: "Kompacter";
    icon: @image-url("tray.png");
    tooltip: root.tip;
    clicked => { root.open(); }
    Menu {
        MenuItem {
            title: "Open Kompacter";
            activated => { root.open(); }
        }
        MenuItem {
            title: "Open Kompacted folder";
            activated => { root.open-folder(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

component Title inherits Text {
    font-size: 19px;
    font-weight: 650;
    color: Theme.label;
    horizontal-alignment: center;
    overflow: elide;
}

component Sub inherits Text {
    font-size: 13px;
    color: Theme.label-2;
    horizontal-alignment: center;
    wrap: word-wrap;
}

/// Quality chip: a word and an arrow. Click to open the details below it.
component Badge inherits Rectangle {
    in property <int> grade; // 3 great, 2 okay, 1 low
    in property <bool> open;
    callback toggled;
    property <color> c: grade >= 3 ? Theme.ok : grade == 2 ? Theme.warn : Theme.bad;
    height: 28px;
    width: row.preferred-width;
    border-radius: 14px;
    background: ta.has-hover ? c.transparentize(0.8) : c.transparentize(0.87);
    animate background { duration: 140ms; }
    transform-scale: ta.pressed ? 0.95 : 1;
    animate transform-scale { duration: 220ms; easing: ease-out-back; }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.grade >= 3 ? "Great quality" : root.grade == 2 ? "Okay quality" : "Low quality";
            font-size: 12px;
            font-weight: 600;
            color: root.c;
            vertical-alignment: center;
        }
        Icon {
            // Turns over when open (GPU drawing); CPU drawing swaps to an up arrow.
            d: root.open && !Fx.rich ? "M7 14l5-5 5 5" : Icons.down;
            size: 16px;
            y: (parent.height - self.height) / 2;
            color: root.c;
            transform-rotation: root.open && Fx.rich ? 180deg : 0deg;
            animate transform-rotation { duration: 280ms; easing: ease-out-back; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component AppWindow inherits Window {
    // ── Set by Rust ──
    in-out property <View> view: View.idle;
    in-out property <bool> dragging;
    /// The card is open (floating card grows/folds with this).
    in-out property <bool> opened: true;
    /// Window content height (Rust delays shrinking until the card has folded in).
    in property <length> win-h: 472px;
    in property <float> progress;
    /// Smoothed squeeze and press intro, driven by Rust each frame while compressing.
    in property <float> squeeze;
    // Smoothed here, at the display's refresh rate, so the press and the % glide.
    property <float> shown: root.squeeze;
    animate shown { duration: 450ms; easing: linear; }
    property <float> intro: root.view == View.busy ? 1 : 0;
    animate intro { duration: 550ms; easing: ease-out; }
    in property <float> look-x;
    in property <float> look-y;
    in property <int> hop;
    in property <int> chomp;
    in property <[PresetItem]> presets;
    in property <int> preset-index;
    in property <string> dash-path;
    in property <string> target-text: "20 MB";

    in property <string> file-name;
    in property <string> file-meta;
    in property <string> file-kind: "file";
    /// The file's own Windows icon (empty: use our line icon).
    in property <image> file-icon;
    in property <float> meter-fill;
    in property <float> meter-limit;
    in property <string> over-text;
    in property <bool> over-ok;
    in property <string> compress-label: "Compress";
    in property <string> foot-text;
    in property <bool> can-trim;
    in property <bool> trim-first;
    /// Before → after details under the file card ("Show more").
    in property <[DiffRow]> diff;
    in-out property <bool> diff-open;
    /// Big summary: size now → size after (estimated).
    in property <string> sum-before;
    in property <string> sum-after;
    /// Too long for one good file: how many parts would each fit well (0 = don't offer).
    in property <int> split-count;
    /// The result was still too big, and splitting can help.
    in property <bool> done-split;

    // Trimmer.
    in property <float> trim-dur: 1;
    in-out property <float> trim-a;
    in-out property <float> trim-b: 1;
    in-out property <int> trim-active;
    in-out property <int> trim-mode;
    in property <[image]> thumbs;
    in property <image> trim-frame;
    in property <string> trim-range;
    in property <string> trim-big;
    in property <string> trim-status;
    in property <bool> trim-ok: true;
    in property <int> trim-grade;
    in property <[DetailRow]> trim-details;
    in property <string> trim-button: "Compress";
    in-out property <bool> trim-playing;
    in-out property <bool> trim-sound: true;
    in property <string> trim-time;
    in property <float> trim-pos;
    in property <string> trim-a-text;
    in property <string> trim-b-text;

    in property <string> busy-left;

    in property <bool> done-ok;
    in property <string> done-title;
    in property <string> done-sub;
    in-out property <string> note;

    in property <string> error-text;

    // Quick bar (shortcut, paste guard, copied files): 0 reading, 1 ready, 2 compressing,
    // 3 done, 4 error, 5 nothing copied.
    in property <int> quick-state;
    /// Paste guard: the bar offers Compress & paste / Trim / Paste anyway.
    in property <bool> guard;

    // Formats.

    // ── Calls into Rust ──
    callback choose-file();
    callback paste();
    callback compress();
    callback split();
    callback cancel();
    callback remove-file();
    callback show-in-folder();
    callback another();
    callback select-preset(int);
    callback open-settings();
    callback close-settings();
    callback open-trim();
    callback close-trim();
    callback trim-changed();
    callback trim-compress();
    callback trim-play();
    callback trim-seek(float);
    callback trim-drag-start();
    callback trim-drag-end(bool);
    callback trim-set-time(int, string);
    callback trim-nudge(int, bool);
    callback escape();
    callback quick-expand();
    callback quick-trim();
    callback paste-anyway();

    property <length> inset: Fx.glass ? 12px : 0;
    property <length> full-h: view == View.trim ? 624px : view == View.settings ? 600px : view == View.quick ? (guard ? 168px : 136px) : 472px;

    title: "Kompacter";
    no-frame: true;
    always-on-top: true;
    background: Fx.glass ? transparent : Theme.bg;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;
    width: 360px + 2 * inset;
    height: win-h + 2 * inset;
    forward-focus: keys;

    property <Mood> mood: dragging ? Mood.hungry
        : view == View.big || view == View.error ? Mood.worried
        : view == View.busy || view == View.reading ? Mood.busy
        : view == View.done ? (done-ok ? Mood.happy : Mood.worried)
        : Mood.idle;
    property <bool> stage-lg: view == View.idle || view == View.done;
    property <bool> stage-md: view == View.reading || view == View.big || view == View.error;
    property <bool> stage-hidden: view == View.big && diff-open;
    property <length> stage-h: stage-lg ? 312px : 124px;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.escape();
                return accept;
            }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                root.paste();
                return accept;
            }
            reject
        }
    }

    // ── The card ──
    card := Rectangle {
        // Open: the card's height springs up from a pill at the bottom; closed: folds down.
        // `vh` follows the screen size; `fold` (0 open … 1 folded) does open/close.
        property <length> vh: root.full-h;
        animate vh { duration: 360ms; easing: ease-out-back; }
        property <float> fold;
        property <length> h: self.vh - (self.vh - 56px) * self.fold;
        states [
            folded when Fx.glass && !root.opened: {
                fold: 1;
                opacity: 0;
                in {
                    animate fold { duration: 200ms; easing: ease-in; }
                    animate opacity { duration: 180ms; easing: ease-in; }
                }
                out {
                    animate fold { duration: 420ms; easing: ease-out-back; }
                    animate opacity { duration: 140ms; }
                }
            }
        ]
        x: root.inset;
        y: root.inset + root.win-h - self.height;
        width: 360px;
        height: Math.min(self.h, root.win-h);
        border-radius: Fx.glass ? 22px : 0;
        background: Fx.glass ? Theme.card : Theme.bg;
        border-width: Fx.glass ? 1px : 0;
        border-color: Theme.hair;
        drop-shadow-blur: Fx.glass ? 22px : 0;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        // Content keeps its full height and sits on the card's bottom edge, so a shorter
        // card reveals it from the bottom up instead of squashing it.
        Rectangle {
            x: 0;
            y: card.height - root.full-h;
            width: 360px;
            height: root.full-h;

            // ── Header ──
            if root.view != View.settings && root.view != View.trim && root.view != View.quick: Rectangle {
                x: 16px;
                y: 14px;
                width: pill-row.preferred-width;
                height: 30px;
                border-radius: 15px;
                background: pill-ta.has-hover ? Theme.fill-hover : Theme.fill;
                animate background { duration: 120ms; }
                transform-scale: pill-ta.pressed ? 0.96 : 1;
                animate transform-scale { duration: 220ms; easing: ease-out-back; }
                pill-row := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    AppLogo {
                        brand: root.presets[root.preset-index].brand;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.presets[root.preset-index].name + " · " + root.target-text;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.label;
                        vertical-alignment: center;
                    }
                    Icon {
                        d: Icons.down;
                        size: 15px;
                        y: (parent.height - self.height) / 2;
                    }
                }
                pill-ta := TouchArea {
                    enabled: root.view != View.busy;
                    mouse-cursor: pointer;
                    clicked => { menu.show(); }
                }
            }
            if root.view != View.settings && root.view != View.trim && root.view != View.quick: IconBtn {
                x: parent.width - 14px - self.width;
                y: 13px;
                icon: Icons.gear;
                tip: "Settings";
                tip-below: true;
                enabled: root.view != View.busy;
                clicked => { root.open-settings(); }
            }

            menu := PopupWindow {
                x: 12px;
                y: 48px;
                width: 268px;
                Rectangle {
                    property <bool> on;
                    Timer {
                        interval: 16ms;
                        running: !parent.on;
                        triggered => { parent.on = true; }
                    }
                    border-radius: 14px;
                    background: Theme.pop;
                    border-width: 1px;
                    border-color: Theme.pop-border;
                    drop-shadow-blur: 18px;
                    drop-shadow-offset-y: 6px;
                    drop-shadow-color: Theme.shadow;
                    opacity: self.on ? 1 : 0;
                    animate opacity { duration: 140ms; }
                    transform-origin: { x: 0, y: 0 };
                    transform-scale: self.on || !Fx.rich ? 1 : 0.94;
                    animate transform-scale { duration: 240ms; easing: ease-out-back; }
                    VerticalLayout {
                        padding: 6px;
                        for p[i] in root.presets: Rectangle {
                            height: 32px;
                            border-radius: 8px;
                            background: row-ta.has-hover ? Theme.accent : transparent;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Icon {
                                    d: Icons.check;
                                    size: 14px;
                                    y: (parent.height - self.height) / 2;
                                    color: row-ta.has-hover ? white : Theme.label;
                                    opacity: i == root.preset-index ? 1 : 0;
                                }
                                AppLogo {
                                    brand: p.brand;
                                    on-accent: row-ta.has-hover;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: p.name;
                                    font-size: 13px;
                                    color: row-ta.has-hover ? white : Theme.label;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: p.size;
                                    font-size: 12px;
                                    color: row-ta.has-hover ? #ffffffd9 : Theme.label-2;
                                    vertical-alignment: center;
                                }
                            }
                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select-preset(i); }
                            }
                        }
                        Rectangle {
                            height: 11px;
                            Rectangle {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 1px;
                                background: Theme.sep;
                            }
                        }
                        Rectangle {
                            height: 32px;
                            border-radius: 8px;
                            background: edit-ta.has-hover ? Theme.accent : transparent;
                            Text {
                                x: 10px;
                                text: "Edit targets…";
                                font-size: 13px;
                                color: edit-ta.has-hover ? white : Theme.label;
                            }
                            edit-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-settings(); }
                            }
                        }
                    }
                }
            }

            // ── Stage: drop zone, blob, sparks ──
            if root.stage-lg || root.stage-md: Rectangle {
                x: 16px;
                y: 50px;
                width: 328px;
                height: root.stage-h;
                animate height { duration: 300ms; easing: ease-out-back; }
                opacity: root.stage-hidden ? 0 : 1;
                animate opacity { duration: Fx.rich ? 200ms : 0ms; easing: ease-out; }
                DropZone {
                    x: 10px;
                    y: 6px;
                    width: parent.width - 20px;
                    height: parent.height - 12px;
                    active: root.dragging;
                    visible-dash: root.view == View.idle;
                    dash-path: root.dash-path;
                }
                // Drop hint inside the dashed box, in the same grey as the dashes.
                if root.view == View.idle: VerticalLayout {
                    y: 196px;
                    width: parent.width;
                    height: 72px;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            d: "M4 14v4.5a1.5 1.5 0 0 0 1.5 1.5h13a1.5 1.5 0 0 0 1.5-1.5V14M12 4v10M8 10l4 4 4-4";
                            size: 28px;
                            color: root.dragging ? Theme.accent-text : Theme.label-2.transparentize(0.5);
                        }
                    }
                    Text {
                        text: root.note != "" ? root.note : root.dragging ? "Drop it" : "Drop or copy a file";
                        font-size: 16px;
                        font-weight: 600;
                        color: root.dragging ? Theme.accent-text : Theme.label-2.transparentize(0.5);
                        horizontal-alignment: center;
                    }
                }
                Blob {
                    mood: root.mood;
                    s: root.stage-lg ? 1 : 0.62;
                    swell: root.dragging;
                    cx: parent.width / 2;
                    cy: root.view == View.idle ? parent.height / 2 - 40px : parent.height / 2;
                    look-x: root.look-x;
                    look-y: root.look-y;
                    hop: root.hop;
                    chomp: root.chomp;
                    touchable: !root.stage-hidden;
                }
                if Fx.rich && root.view == View.done && root.done-ok: Sparks {
                    width: parent.width;
                    height: parent.height;
                }
            }
            if root.view == View.busy: Rectangle {
                x: 0;
                y: 50px;
                width: 360px;
                height: 252px;
                Blob {
                    mood: Mood.busy;
                    s: 0.85;
                    c: root.shown;
                    touchable: false;
                    cx: parent.width / 2;
                    cy: parent.height / 2;
                }
                Press {
                    width: parent.width;
                    height: parent.height;
                    c: root.shown;
                    intro: root.intro;
                }
            }

            // ── Views: big text and buttons; the stage and controls say the rest ──
            if root.view == View.idle: Appear {
                x: 20px;
                y: 384px;
                width: 320px;
                height: 40px;
                HorizontalLayout {
                    y: 0;
                    height: 36px;
                    spacing: 8px;
                    alignment: center;
                    Btn {
                        text: "Choose File…";
                        icon: Icons.folder;
                        primary: true;
                        clicked => { root.choose-file(); }
                    }
                    Btn {
                        text: "Paste";
                        icon: Icons.clip;
                        tip: "Ctrl+V";
                        clicked => { root.paste(); }
                    }
                }
            }

            if root.view == View.reading: Appear {
                x: 20px;
                y: 196px;
                width: 320px;
                height: 24px;
                Title {
                    width: parent.width;
                    text: root.file-name;
                }
            }

            // Big file. "Show more" glides the content up over the blob and cross-fades the
            // bar and summary into the before → after list. Nothing is removed and re-added,
            // so the bar fills once when the view opens and never replays.
            if root.view == View.big: Appear {
                x: 20px;
                y: root.diff-open ? 52px : 186px;
                animate y { duration: Fx.rich ? 380ms : 0ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
                width: 320px;
                height: 400px;
                // File card.
                Rectangle {
                    y: 0;
                    height: 56px;
                    if root.file-icon.width > 0: Image {
                        x: 0;
                        y: 6px;
                        width: 44px;
                        height: 44px;
                        source: root.file-icon;
                        image-fit: contain;
                    }
                    if root.file-icon.width == 0: Rectangle {
                        x: 0;
                        y: 8px;
                        width: 40px;
                        height: 40px;
                        border-radius: 10px;
                        background: Theme.accent-soft;
                        Icon {
                            d: root.file-kind == "video" ? Icons.film
                                : root.file-kind == "audio" ? Icons.music
                                : root.file-kind == "image" ? Icons.image
                                : root.file-kind == "folder" ? Icons.folder
                                : Icons.file;
                            color: Theme.accent-text;
                        }
                    }
                    Text {
                        x: 52px;
                        y: 9px;
                        width: parent.width - 52px - 40px;
                        text: root.file-name;
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.label;
                        overflow: elide;
                    }
                    Text {
                        x: 52px;
                        y: 30px;
                        width: parent.width - 52px - 40px;
                        text: root.file-meta;
                        font-size: 13px;
                        color: Theme.label-2;
                        overflow: elide;
                    }
                    IconBtn {
                        x: parent.width - self.width;
                        y: 12px;
                        icon: Icons.x;
                        clicked => { root.remove-file(); }
                    }
                }
                // "Show more": the before → after list.
                if root.diff.length > 0: Rectangle {
                    x: 52px;
                    y: 52px;
                    width: more-row.preferred-width;
                    height: 20px;
                    more-row := HorizontalLayout {
                        spacing: 2px;
                        Text {
                            text: root.diff-open ? "Show less" : "Show more";
                            font-size: 12px;
                            color: more-ta.has-hover ? Theme.label : Theme.label-2;
                            vertical-alignment: center;
                        }
                        Icon {
                            d: Icons.down;
                            size: 14px;
                            y: 3px;
                            color: more-ta.has-hover ? Theme.label : Theme.label-2;
                            transform-rotation: root.diff-open ? 180deg : 0deg;
                            animate transform-rotation { duration: Fx.rich ? 340ms : 0ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
                        }
                    }
                    more-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.diff-open = !root.diff-open; }
                    }
                }
                // The before → after list: fades in a moment after the bar fades out.
                if root.diff.length > 0: Flickable {
                    y: 80px;
                    width: parent.width;
                    height: 220px;
                    interactive: root.diff-open;
                    opacity: 0;
                    states [
                        open when root.diff-open: {
                            opacity: 1;
                            in {
                                animate opacity { duration: Fx.rich ? 240ms : 0ms; delay: Fx.rich ? 120ms : 0ms; easing: ease-out; }
                            }
                            out {
                                animate opacity { duration: Fx.rich ? 90ms : 0ms; easing: ease-in; }
                            }
                        }
                    ]
                    VerticalLayout {
                        spacing: 0;
                        for r in root.diff: HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            padding-left: r.depth * 14px;
                            if r.icon != "": Icon {
                                d: r.icon == "dir" ? Icons.folder : Icons.file;
                                size: 14px;
                                y: 5px;
                            }
                            Text {
                                text: r.label;
                                font-size: 12px;
                                font-weight: r.depth == 0 && r.icon == "dir" ? 600 : 400;
                                color: Theme.label;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: r.before;
                                font-size: 12px;
                                color: Theme.label-2;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "→";
                                font-size: 12px;
                                color: r.changed ? Theme.ok : Theme.label-2;
                                vertical-alignment: center;
                            }
                            Text {
                                text: r.after;
                                font-size: 12px;
                                font-weight: 600;
                                color: r.changed ? Theme.ok : Theme.label-2;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Size against the limit; the bar fills when the view appears.
                meter := Rectangle {
                    y: 80px;
                    height: 28px;
                    // Fades out (stays in place, keeps its fill) while the details show.
                    states [
                        hidden when root.diff-open: {
                            opacity: 0;
                            in {
                                animate opacity { duration: Fx.rich ? 90ms : 0ms; easing: ease-in; }
                            }
                            out {
                                animate opacity { duration: Fx.rich ? 240ms : 0ms; delay: Fx.rich ? 120ms : 0ms; easing: ease-out; }
                            }
                        }
                    ]
                    property <bool> shown;
                    Timer {
                        interval: 60ms;
                        running: !meter.shown;
                        triggered => { meter.shown = true; }
                    }
                    Text {
                        x: parent.width * root.meter-limit - 40px;
                        y: 0;
                        width: 80px;
                        text: root.target-text;
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.label-2;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        y: 18px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.fill;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: meter.shown ? parent.width * root.meter-fill : 0;
                            animate width { duration: 700ms; easing: ease-out; }
                            background: Theme.bad;
                        }
                        Rectangle {
                            x: 0;
                            width: meter.shown ? parent.width * Math.min(root.meter-fill, root.meter-limit) : 0;
                            animate width { duration: 700ms; easing: ease-out; }
                            background: Theme.accent;
                        }
                    }
                    Rectangle {
                        x: parent.width * root.meter-limit - 1px;
                        y: 14px;
                        width: 2px;
                        height: 16px;
                        border-radius: 1px;
                        background: Theme.label;
                    }
                }
                // What it becomes, big: before (grey) → after (green); how far over, on the right.
                HorizontalLayout {
                    y: 114px;
                    width: parent.width;
                    height: 24px;
                    states [
                        hidden when root.diff-open: {
                            opacity: 0;
                            in {
                                animate opacity { duration: Fx.rich ? 90ms : 0ms; easing: ease-in; }
                            }
                            out {
                                animate opacity { duration: Fx.rich ? 240ms : 0ms; delay: Fx.rich ? 120ms : 0ms; easing: ease-out; }
                            }
                        }
                    ]
                    spacing: 6px;
                    Text {
                        text: root.sum-before;
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.label-2;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "→";
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.ok;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.sum-after;
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.ok;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.over-text;
                        font-size: 12px;
                        font-weight: 600;
                        color: root.over-ok ? Theme.ok : Theme.bad;
                        vertical-alignment: center;
                    }
                }
                // Too long for one good file: trim it, or split it into parts that each fit.
                if root.split-count > 1: HorizontalLayout {
                    y: root.diff-open ? 312px : 152px;
                    animate y { duration: Fx.rich ? 380ms : 0ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
                    height: 44px;
                    spacing: 8px;
                    Btn {
                        text: "Trim";
                        icon: Icons.scissors;
                        primary: true;
                        large: true;
                        horizontal-stretch: 1;
                        clicked => { root.open-trim(); }
                    }
                    Btn {
                        text: "Split into " + root.split-count;
                        large: true;
                        horizontal-stretch: 1;
                        tip: root.split-count + " files, each under " + root.target-text;
                        clicked => { root.split(); }
                    }
                }
                if root.split-count > 1: HorizontalLayout {
                    y: root.diff-open ? 362px : 206px;
                    animate y { duration: Fx.rich ? 380ms : 0ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
                    height: 36px;
                    alignment: center;
                    Btn {
                        text: "Compress anyway";
                        plain: true;
                        clicked => { root.compress(); }
                    }
                }
                if root.split-count <= 1: HorizontalLayout {
                    y: root.diff-open ? 312px : 152px;
                    animate y { duration: Fx.rich ? 380ms : 0ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
                    height: 44px;
                    spacing: 8px;
                    if root.can-trim && root.trim-first: Btn {
                        text: "Trim";
                        icon: Icons.scissors;
                        primary: true;
                        large: true;
                        horizontal-stretch: 1;
                        clicked => { root.open-trim(); }
                    }
                    Btn {
                        text: root.compress-label;
                        icon: Icons.squeeze;
                        primary: !root.trim-first;
                        large: true;
                        horizontal-stretch: 1.4;
                        clicked => { root.compress(); }
                    }
                    if root.can-trim && !root.trim-first: Btn {
                        text: "Trim";
                        icon: Icons.scissors;
                        large: true;
                        horizontal-stretch: 1;
                        clicked => { root.open-trim(); }
                    }
                }
                if root.foot-text != "" && root.split-count <= 1: Text {
                    y: 206px;
                    width: parent.width;
                    states [
                        hidden when root.diff-open: {
                            opacity: 0;
                            in {
                                animate opacity { duration: Fx.rich ? 90ms : 0ms; easing: ease-in; }
                            }
                            out {
                                animate opacity { duration: Fx.rich ? 240ms : 0ms; delay: Fx.rich ? 120ms : 0ms; easing: ease-out; }
                            }
                        }
                    ]
                    text: root.foot-text;
                    font-size: 12px;
                    color: Theme.label-2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // ── Quick bar: the file, what it becomes, one button ──
            if root.view == View.quick: Appear {
                x: 16px;
                width: 328px;
                height: root.full-h;
                // File icon (or a line icon; a clipboard when nothing is copied).
                if root.file-icon.width > 0 && root.quick-state != 5: Image {
                    x: 0;
                    y: 16px;
                    width: 40px;
                    height: 40px;
                    source: root.file-icon;
                    image-fit: contain;
                }
                if root.file-icon.width == 0 || root.quick-state == 5: Rectangle {
                    x: 0;
                    y: 16px;
                    width: 40px;
                    height: 40px;
                    border-radius: 10px;
                    background: root.quick-state == 3 && root.done-ok ? Theme.ok.transparentize(0.85)
                        : root.quick-state == 4 ? Theme.bad.transparentize(0.85) : Theme.accent-soft;
                    animate background { duration: 200ms; }
                    Icon {
                        d: root.quick-state == 3 && root.done-ok ? Icons.check
                            : root.quick-state == 5 ? Icons.clip
                            : root.file-kind == "video" ? Icons.film
                            : root.file-kind == "audio" ? Icons.music
                            : root.file-kind == "image" ? Icons.image
                            : root.file-kind == "folder" ? Icons.folder
                            : Icons.file;
                        color: root.quick-state == 3 && root.done-ok ? Theme.ok
                            : root.quick-state == 4 ? Theme.bad : Theme.accent-text;
                    }
                }
                Text {
                    x: 52px;
                    y: 15px;
                    width: parent.width - 52px - 68px;
                    text: root.quick-state == 5 ? "Nothing copied"
                        : root.quick-state == 3 ? root.done-title
                        : root.file-name;
                    font-size: 15px;
                    font-weight: 600;
                    color: root.quick-state == 3 && root.done-ok ? Theme.ok : Theme.label;
                    overflow: elide;
                }
                // Second line: before → after, progress, the result, or what went wrong.
                if root.quick-state == 1: HorizontalLayout {
                    x: 52px;
                    y: 36px;
                    width: parent.width - 52px - 68px;
                    height: 20px;
                    spacing: 5px;
                    Text {
                        text: root.sum-before;
                        font-size: 13px;
                        color: Theme.label-2;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "→";
                        font-size: 13px;
                        color: Theme.ok;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.sum-after;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.ok;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                if root.quick-state != 1: Text {
                    x: 52px;
                    y: 36px;
                    width: parent.width - 52px - 8px;
                    height: 20px;
                    text: root.quick-state == 0 ? "Reading…"
                        : root.quick-state == 2 ? root.busy-left
                        : root.quick-state == 3 ? root.done-sub
                        : root.quick-state == 4 ? root.error-text
                        : "Copy a file, then press the shortcut";
                    font-size: 13px;
                    color: root.quick-state == 4 ? Theme.bad : Theme.label-2;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Open the full window, close.
                IconBtn {
                    x: parent.width - 68px;
                    y: 14px;
                    icon: "M14 4h6v6M20 4l-6.5 6.5M10 20H4v-6M4 20l6.5-6.5";
                    tip: "Open Kompacter";
                    tip-below: true;
                    clicked => { root.quick-expand(); }
                }
                IconBtn {
                    x: parent.width - 32px;
                    y: 14px;
                    icon: Icons.x;
                    clicked => { root.escape(); }
                }

                // Bottom row.
                if root.quick-state == 1: HorizontalLayout {
                    y: 76px;
                    height: 44px;
                    spacing: 8px;
                    Btn {
                        text: root.guard ? "Compress & paste" : root.compress-label;
                        icon: Icons.squeeze;
                        primary: true;
                        large: true;
                        horizontal-stretch: 1;
                        clicked => { root.compress(); }
                    }
                    if root.can-trim: Btn {
                        text: "Trim";
                        icon: Icons.scissors;
                        large: true;
                        clicked => { root.quick-trim(); }
                    }
                }
                // Paste guard: or paste the original after all.
                if root.quick-state == 1 && root.guard: HorizontalLayout {
                    y: 126px;
                    height: 32px;
                    alignment: center;
                    Btn {
                        text: "Paste anyway";
                        plain: true;
                        clicked => { root.paste-anyway(); }
                    }
                }
                if root.quick-state == 0 || root.quick-state == 2: Rectangle {
                    y: 76px;
                    height: 44px;
                    // Progress: fills smoothly; reading shows a slow sweep.
                    Rectangle {
                        x: 0;
                        y: 18px;
                        width: parent.width - 124px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.fill;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * (root.quick-state == 2 ? root.shown : 0);
                            border-radius: 4px;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        x: parent.width - 118px;
                        width: 36px;
                        text: root.quick-state == 2 ? Math.round(root.shown * 100) + "%" : "";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.label-2;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    if root.quick-state == 2: Btn {
                        x: parent.width - self.width;
                        y: 4px;
                        width: 76px;
                        text: "Cancel";
                        plain: true;
                        clicked => { root.cancel(); }
                    }
                }
                if root.quick-state == 3: HorizontalLayout {
                    y: 76px;
                    height: 44px;
                    spacing: 8px;
                    Btn {
                        text: "Show in folder";
                        icon: Icons.open;
                        large: true;
                        horizontal-stretch: 1;
                        clicked => { root.show-in-folder(); }
                    }
                    Btn {
                        text: "Done";
                        primary: true;
                        large: true;
                        horizontal-stretch: 1;
                        clicked => { root.escape(); }
                    }
                }
                if root.quick-state == 4 || root.quick-state == 5: HorizontalLayout {
                    y: 76px;
                    height: 44px;
                    spacing: 8px;
                    Btn {
                        text: "Choose File…";
                        icon: Icons.folder;
                        primary: root.quick-state == 5;
                        large: true;
                        horizontal-stretch: 1;
                        clicked => { root.choose-file(); }
                    }
                    Btn {
                        text: "Open Kompacter";
                        large: true;
                        horizontal-stretch: 1;
                        clicked => { root.quick-expand(); }
                    }
                }
            }

            if root.view == View.trim: Appear {
                width: 360px;
                height: 624px;
                // Header: back, name, selected range.
                IconBtn {
                    x: 8px;
                    y: 14px;
                    icon: Icons.back;
                    clicked => { root.close-trim(); }
                }
                Text {
                    x: 48px;
                    y: 12px;
                    width: 290px;
                    text: root.file-name;
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.label;
                    overflow: elide;
                }
                // Preview of the frame at the handle being moved.
                Rectangle {
                    x: 20px;
                    y: 62px;
                    width: 320px;
                    height: 150px;
                    border-radius: 12px;
                    background: Theme.fill;
                    clip: true;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.trim-frame;
                        image-fit: contain;
                    }
                    pv := TouchArea {
                        clicked => { root.trim-play(); }
                    }
                    // Controls appear while the pointer is over the video. The sound button
                    // has its own touch area on top, so count hovering it too.
                    Rectangle {
                        opacity: pv.has-hover || snd.has-hover ? 1 : 0;
                        animate opacity { duration: 160ms; }
                        // Play / pause.
                        Rectangle {
                            x: 10px;
                            y: parent.height - 40px;
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: #000000a0;
                            Path {
                                width: 16px;
                                height: 16px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: root.trim-playing ? "M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" : "M8 5.5v13l11-6.5z";
                                fill: white;
                            }
                        }
                        // Time of the frame shown, to the millisecond.
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 36px;
                            width: time-text.preferred-width + 16px;
                            height: 22px;
                            border-radius: 11px;
                            background: #000000a0;
                            time-text := Text {
                                text: root.trim-time;
                                font-size: 12px;
                                color: white;
                            }
                        }
                        // Sound on / off.
                        Rectangle {
                            x: parent.width - 40px;
                            y: parent.height - 40px;
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: snd.has-hover ? #000000d0 : #000000a0;
                            Icon {
                                d: root.trim-sound
                                    ? "M4 9.5h3.5L12 6v12l-4.5-3.5H4zM15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"
                                    : "M4 9.5h3.5L12 6v12l-4.5-3.5H4zM16 9.5l5 5M21 9.5l-5 5";
                                size: 18px;
                                color: white;
                            }
                            snd := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.trim-sound = !root.trim-sound; }
                            }
                        }
                    }
                }
                // Filmstrip with two handles.
                strip := Rectangle {
                    property <float> fa: root.trim-a / Math.max(0.001, root.trim-dur);
                    property <float> fb: root.trim-b / Math.max(0.001, root.trim-dur);
                    x: 20px;
                    y: 228px;
                    width: 320px;
                    height: 48px;
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.fill;
                        clip: true;
                        HorizontalLayout {
                            for t in root.thumbs: Image {
                                source: t;
                                image-fit: cover;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    // Dim what's cut away.
                    Rectangle {
                        x: 0;
                        width: parent.width * strip.fa;
                        border-top-left-radius: 8px;
                        border-bottom-left-radius: 8px;
                        background: #000000a6;
                    }
                    Rectangle {
                        x: parent.width * strip.fb;
                        width: parent.width * (1 - strip.fb);
                        border-top-right-radius: 8px;
                        border-bottom-right-radius: 8px;
                        background: #000000a6;
                    }
                    // Selection frame.
                    Rectangle {
                        x: parent.width * strip.fa;
                        width: parent.width * (strip.fb - strip.fa);
                        border-width: 2px;
                        border-color: Theme.accent;
                        border-radius: 6px;
                    }
                    for side in 2: Rectangle {
                        property <float> f: side == 0 ? strip.fa : strip.fb;
                        property <bool> on: root.trim-active == side && drag.pressed;
                        x: strip.width * self.f - self.width / 2;
                        y: -4px;
                        width: 14px;
                        height: 56px;
                        border-radius: 5px;
                        background: Theme.accent;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000059;
                        transform-scale: self.on ? 1.12 : 1;
                        animate transform-scale { duration: 220ms; easing: ease-out-back; }
                        Rectangle {
                            width: 2px;
                            height: 18px;
                            border-radius: 1px;
                            background: #ffffffd9;
                        }
                        // Exact time above the handle while it moves.
                        if root.trim-active == side && drag.pressed: Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: -26px;
                            width: tip-text.preferred-width + 12px;
                            height: 20px;
                            border-radius: 10px;
                            background: Theme.accent;
                            tip-text := Text {
                                text: side == 0 ? root.trim-a-text : root.trim-b-text;
                                font-size: 11px;
                                font-weight: 600;
                                color: white;
                            }
                        }
                    }
                    // Arrow keys nudge the active handle one frame (Shift: one second).
                    keys-strip := FocusScope {
                        key-pressed(e) => {
                            if (e.text == Key.LeftArrow) {
                                root.trim-nudge(-1, e.modifiers.shift);
                                return accept;
                            }
                            if (e.text == Key.RightArrow) {
                                root.trim-nudge(1, e.modifiers.shift);
                                return accept;
                            }
                            reject
                        }
                    }
                    drag := TouchArea {
                        y: -8px;
                        height: 60px;
                        mouse-cursor: ew-resize;
                        function move-to(f: float) {
                            if (root.trim-active == 0) {
                                root.trim-a = Math.max(0, Math.min(f * root.trim-dur, root.trim-b - 1));
                            } else {
                                root.trim-b = Math.min(root.trim-dur, Math.max(f * root.trim-dur, root.trim-a + 1));
                            }
                            root.trim-changed();
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                keys-strip.focus();
                                root.trim-drag-start();
                                // Grab the nearer handle.
                                root.trim-active = Math.abs(Math.clamp(self.mouse-x / self.width, 0, 1) - strip.fa) <= Math.abs(Math.clamp(self.mouse-x / self.width, 0, 1) - strip.fb) ? 0 : 1;
                                self.move-to(Math.clamp(self.mouse-x / self.width, 0, 1));
                            }
                        }
                        changed pressed => {
                            if (!self.pressed) {
                                root.trim-drag-end(false);
                            }
                        }
                        moved => {
                            self.move-to(Math.clamp(self.mouse-x / self.width, 0, 1));
                        }
                    }
                    // Playhead: where the video is. The arrow under the strip is its only
                    // grip, so seeking never grabs a trim handle by mistake.
                    playhead := Rectangle {
                        property <length> px: strip.width * Math.clamp(root.trim-pos / Math.max(0.001, root.trim-dur), 0, 1);
                        x: self.px - 1px;
                        y: -3px;
                        width: 2px;
                        height: 54px;
                        border-radius: 1px;
                        background: white;
                        drop-shadow-blur: 3px;
                        drop-shadow-color: #00000080;
                    }
                    Path {
                        x: playhead.px - 9px;
                        y: 52px;
                        width: 18px;
                        height: 14px;
                        viewbox-width: 18;
                        viewbox-height: 14;
                        commands: "M9 1.5L16.5 12H1.5Z";
                        fill: white;
                        stroke: seek.pressed || seek.has-hover ? Theme.accent : #00000066;
                        stroke-width: 1.4px;
                        stroke-line-join: round;
                        transform-scale: seek.pressed ? 1.2 : 1;
                        animate transform-scale { duration: 200ms; easing: ease-out-back; }
                    }
                    seek := TouchArea {
                        x: playhead.px - 14px;
                        y: 52px;
                        width: 28px;
                        height: 18px;
                        mouse-cursor: ew-resize;
                        function seek-to() {
                            root.trim-seek(Math.clamp((self.x + self.mouse-x) / strip.width, 0, 1) * root.trim-dur);
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.trim-drag-start();
                                self.seek-to();
                            }
                        }
                        changed pressed => {
                            if (!self.pressed) {
                                root.trim-drag-end(true);
                            }
                        }
                        moved => { self.seek-to(); }
                    }
                }
                // Start and end, typed to the millisecond (m:ss.mmm).
                for side in 2: Rectangle {
                    property <string> src: side == 0 ? root.trim-a-text : root.trim-b-text;
                    changed src => { field.text = self.src; }
                    x: side == 0 ? 20px : 340px - self.width;
                    y: 304px;
                    width: 104px;
                    height: 26px;
                    border-radius: 7px;
                    background: Theme.fill;
                    field := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        text: parent.src;
                        font-size: 13px;
                        color: Theme.label;
                        horizontal-alignment: side == 0 ? left : right;
                        vertical-alignment: center;
                        accepted => { root.trim-set-time(side, self.text); }
                    }
                }
                Text {
                    x: 124px;
                    y: 304px;
                    width: 112px;
                    height: 26px;
                    text: root.trim-range;
                    font-size: 12px;
                    color: Theme.label-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                // Mode and live readout.
                Seg {
                    x: 20px;
                    y: 342px;
                    width: 320px;
                    options: ["Keep quality", "Fit to " + root.target-text, "GIF"];
                    index: root.trim-mode;
                    picked(i) => {
                        root.trim-mode = i;
                        root.trim-changed();
                    }
                }
                readout := Rectangle {
                    property <bool> open;
                    property <length> extra: details.preferred-height;
                    x: 20px;
                    y: 388px;
                    width: 320px;
                    height: 76px + (self.open ? self.extra : 0);
                    animate height { duration: 320ms; easing: Fx.rich ? ease-out-back : ease-out; }
                    border-radius: 12px;
                    background: Theme.group;
                    clip: true;
                    Text {
                        x: 16px;
                        y: 10px;
                        height: 34px;
                        text: root.trim-big;
                        font-size: 26px;
                        font-weight: 700;
                        color: Theme.label;
                        vertical-alignment: center;
                    }
                    if root.trim-grade > 0: Badge {
                        x: parent.width - self.width - 12px;
                        y: 13px;
                        grade: root.trim-grade;
                        open: readout.open;
                        toggled => { readout.open = !readout.open; }
                    }
                    HorizontalLayout {
                        x: 16px;
                        y: 46px;
                        height: 20px;
                        spacing: 6px;
                        Icon {
                            d: root.trim-ok ? Icons.okc : Icons.xc;
                            size: 16px;
                            y: 2px;
                            color: root.trim-ok ? Theme.ok : Theme.bad;
                        }
                        Text {
                            text: root.trim-status;
                            font-size: 13px;
                            font-weight: 600;
                            color: root.trim-ok ? Theme.ok : Theme.bad;
                            vertical-alignment: center;
                        }
                    }
                    // Details: resolution, frame rate and bitrate of the result.
                    details := VerticalLayout {
                        y: 76px;
                        width: parent.width;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 14px;
                        spacing: 6px;
                        opacity: readout.open ? 1 : 0;
                        animate opacity { duration: 200ms; }
                        Rectangle {
                            height: 1px;
                            background: Theme.sep;
                        }
                        for d in root.trim-details: HorizontalLayout {
                            height: 18px;
                            Text {
                                text: d.label;
                                font-size: 12px;
                                color: Theme.label-2;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: d.value;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.label;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Btn {
                    x: 20px;
                    y: readout.y + readout.height + 18px;
                    width: 320px;
                    text: root.trim-button;
                    icon: Icons.squeeze;
                    primary: true;
                    large: true;
                    clicked => { root.trim-compress(); }
                }
            }

            if root.view == View.busy: Appear {
                x: 20px;
                y: 310px;
                width: 320px;
                height: 142px;
                Text {
                    y: 0;
                    width: parent.width;
                    height: 34px;
                    text: Math.round(root.shown * 100) + "%";
                    font-size: 28px;
                    font-weight: 700;
                    color: Theme.label;
                    horizontal-alignment: center;
                }
                Sub {
                    y: 38px;
                    width: parent.width;
                    height: 18px;
                    text: root.busy-left;
                }
                HorizontalLayout {
                    y: 74px;
                    height: 36px;
                    alignment: center;
                    Btn {
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                }
            }

            if root.view == View.done: Appear {
                x: 20px;
                y: 360px;
                width: 320px;
                height: 92px;
                HorizontalLayout {
                    y: 0;
                    height: 26px;
                    spacing: 6px;
                    alignment: center;
                    Icon {
                        d: root.done-ok ? Icons.okc : Icons.xc;
                        size: 20px;
                        y: 3px;
                        color: root.done-ok ? Theme.ok : Theme.bad;
                    }
                    Title {
                        text: root.done-title;
                        color: root.done-ok ? Theme.label : Theme.bad;
                    }
                }
                // One quiet line: the result (size, resolution), or what to do next.
                Sub {
                    y: 30px;
                    width: parent.width;
                    height: 18px;
                    text: root.done-sub;
                }
                HorizontalLayout {
                    y: 56px;
                    height: 36px;
                    spacing: 8px;
                    alignment: center;
                    if root.done-split: Btn {
                        text: "Split into parts";
                        primary: true;
                        clicked => { root.split(); }
                    }
                    if !root.done-split: Btn {
                        text: "Show in Folder";
                        icon: Icons.open;
                        clicked => { root.show-in-folder(); }
                    }
                    Btn {
                        text: "Another";
                        plain: true;
                        clicked => { root.another(); }
                    }
                }
            }

            if root.view == View.error: Appear {
                x: 20px;
                y: 186px;
                width: 320px;
                height: 160px;
                HorizontalLayout {
                    y: 0;
                    height: 26px;
                    spacing: 6px;
                    alignment: center;
                    Icon {
                        d: Icons.xc;
                        size: 20px;
                        y: 3px;
                        color: Theme.bad;
                    }
                    Title { text: "Couldn't do that"; }
                }
                Sub {
                    y: 32px;
                    width: parent.width;
                    height: 54px;
                    text: root.error-text;
                }
                HorizontalLayout {
                    y: 96px;
                    height: 36px;
                    alignment: center;
                    Btn {
                        text: "Try another";
                        primary: true;
                        clicked => { root.another(); }
                    }
                }
            }

            // ── Settings ──
            if root.view == View.settings: SettingsView {
                presets: root.presets;
                preset-index: root.preset-index;
                select-preset(i) => { root.select-preset(i); }
                close-settings => { root.close-settings(); }
            }
        }
    }
}
