// Colors and shared controls. Colors match the original Kompacter design tokens, plus the
// Discord-style palettes (Light / Ash / Dark / Onyx).

import { Icons } from "icons.slint";

/// Effects level. `rich`: every animation (breathing, eye tracking, bounces, sparks,
/// marching dashes). Off in Low-memory mode (or when Windows animations are off), which
/// keeps only open/close and simple fades.
/// `glass`: the floating, slightly see-through card with its own shadow (GPU drawing).
export global Fx {
    in-out property <bool> rich: true;
    in-out property <bool> glass;
}

export global Theme {
    /// Kompacter style: follows this.
    in-out property <bool> dark;
    /// 0 = Kompacter, 1 = Discord.
    in-out property <int> style;
    /// Discord palette: 0 Light, 1 Ash, 2 Dark, 3 Onyx.
    in-out property <int> dt;

    property <bool> dc: style == 1;
    out property <bool> is-dark: dc ? dt != 0 : dark;

    pure function pick(k-light: color, k-dark: color, d-light: color, d-ash: color, d-dark: color, d-onyx: color) -> color {
        return !dc ? (dark ? k-dark : k-light) : dt == 0 ? d-light : dt == 1 ? d-ash : dt == 2 ? d-dark : d-onyx;
    }

    /// The card: opaque, and a see-through version for the floating card.
    out property <color> bg: pick(#fafafc, #2c2c30, #ffffff, #323339, #1f2024, #0c0c0e);
    out property <color> card: bg.transparentize(dc ? 0.03 : 0.08);
    out property <color> fill: pick(#7878801f, #7878803d, #ebebed, #26272b, #141517, #ffffff14);
    out property <color> fill-2: pick(#78788033, #78788057, #dcdce0, #3d3e45, #2c2d32, #ffffff24);
    out property <color> fill-hover: pick(#78788029, #7878804d, #e2e2e5, #36373d, #25262a, #ffffff1f);
    out property <color> group: pick(#ffffffd9, #ffffff0f, #f2f3f5, #ffffff0a, #ffffff0a, #ffffff0a);
    out property <color> sep: pick(#3c3c4329, #54545899, #2e2f3424, #ffffff14, #ffffff14, #ffffff17);
    out property <color> hair: pick(#00000014, #ffffff1a, #00000014, #ffffff14, #ffffff14, #ffffff1a);
    out property <color> label: pick(#1d1d1f, #f5f5f7, #2e2f34, #ffffff, #f2f3f5, #ffffff);
    out property <color> label-2: pick(#5f5f66, #b4b4ba, #5c5e66, #c4c5cb, #b5bac1, #b5b7bd);
    out property <color> accent: dc ? #4752c4 : #0071e3;
    out property <color> accent-hover: dc ? #3c45a8 : #0063c7;
    out property <color> accent-text: pick(#0066cc, #4da3ff, #4752c4, #a5acff, #a5acff, #a5acff);
    out property <color> accent-soft: pick(#0071e31f, #0a84ff33, #5865f224, #5865f242, #5865f23d, #5865f238);
    out property <color> on-accent: #ffffff;
    out property <color> ok: pick(#1a7f37, #30d158, #1a7f37, #3ba55c, #3ba55c, #3ba55c);
    out property <color> bad: pick(#d70015, #ff6961, #d70015, #f2777a, #f2777a, #f2777a);
    out property <color> warn: pick(#9a5b00, #ffd60a, #9a5b00, #f0b232, #f0b232, #f0b232);
    out property <color> pouch-b: dc ? (is-dark ? #8891f2 : #9aa4ff) : (dark ? #7aa9ff : #9cc4ff);
    out property <color> face: #13213f;
    out property <color> shadow: is-dark ? #0000008c : #00000052;
    /// Tooltip / menu surface.
    out property <color> pop: pick(#ffffff, #3a3a3e, #ffffff, #3d3e45, #2c2d32, #1a1a1e);
    out property <color> pop-border: is-dark ? #ffffff26 : #d1d1d6;
}

/// A 24×24 line icon.
export component Icon inherits Path {
    in property <string> d;
    in property <color> color: Theme.label-2;
    in property <length> size: 18px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: d;
    fill: transparent;
    stroke: color;
    stroke-width: 1.5px;
    stroke-line-cap: round;
}

/// App logo for a preset: a filled brand glyph, or a neutral line icon.
export component AppLogo inherits Rectangle {
    in property <string> brand;
    in property <bool> on-accent;
    width: 15px;
    height: 15px;
    if brand == "mail" || brand == "custom": Icon {
        size: 15px;
        d: brand == "mail" ? Icons.mail : Icons.custom;
        color: root.on-accent ? white : Theme.label-2;
    }
    if brand != "mail" && brand != "custom": Path {
        width: 15px;
        height: 15px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: brand == "discord" ? Icons.brand-discord
            : brand == "whatsapp" ? Icons.brand-whatsapp
            : brand == "telegram" ? Icons.brand-telegram
            : brand == "slack" ? Icons.brand-slack
            : Icons.brand-gmail;
        fill: root.on-accent ? white
            : brand == "discord" ? #5865f2
            : brand == "whatsapp" ? #1fa855
            : brand == "telegram" ? #229ed9
            : brand == "slack" ? (Theme.is-dark ? #e3b6e6 : #4a154b)
            : #ea4335;
    }
}

/// Small label that fades in after the pointer rests on something for half a second.
export component Tip inherits Rectangle {
    in property <string> text;
    in property <bool> hovered;
    /// Show under the thing instead of above (for things at the top of the window).
    in property <bool> below;
    /// Size of the thing it describes (a component can't see its parent).
    in property <length> host-w;
    in property <length> host-h;
    property <bool> show;
    changed hovered => {
        if (!self.hovered) {
            self.show = false;
        }
    }
    x: (host-w - self.width) / 2;
    y: below ? host-h + 6px : -self.height - 6px;
    width: label.preferred-width + 16px;
    height: 24px;
    border-radius: 6px;
    background: Theme.pop;
    border-width: 1px;
    border-color: Theme.pop-border;
    opacity: show && text != "" ? 1 : 0;
    animate opacity { duration: 120ms; }
    Timer {
        interval: 500ms;
        running: root.hovered && !root.show;
        triggered => { root.show = true; }
    }
    label := Text {
        text: root.text;
        color: Theme.label;
        font-size: 12px;
        vertical-alignment: center;
    }
}

/// Pill button: default (grey), primary (blue) or plain (text only).
/// Shrinks a little while pressed and springs back, like the original.
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> plain;
    in property <bool> large;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked;

    height: large ? 44px : 36px;
    border-radius: self.height / 2;
    opacity: enabled ? 1 : 0.45;
    background: plain ? (ta.has-hover ? Theme.fill : transparent)
        : primary ? (ta.has-hover || ta.pressed ? Theme.accent-hover : Theme.accent)
        : (ta.has-hover || ta.pressed ? Theme.fill-hover : Theme.fill);
    animate background { duration: 140ms; }
    transform-scale: ta.pressed ? 0.96 : 1;
    animate transform-scale { duration: 220ms; easing: ease-out-back; }

    HorizontalLayout {
        padding-left: plain ? 10px : large ? 20px : 16px;
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            d: root.icon;
            size: 15px;
            y: (parent.height - self.height) / 2;
            color: root.primary ? Theme.on-accent : root.plain ? Theme.accent-text : Theme.label;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: root.large ? 15px : 14px;
            font-weight: root.primary ? 600 : 500;
            color: root.primary ? Theme.on-accent : root.plain ? Theme.accent-text : Theme.label;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hovered: ta.has-hover;
        host-w: root.width;
        host-h: root.height;
    }
}

/// Round, icon-only button.
export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <bool> tip-below;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    opacity: enabled ? 1 : 0.45;
    background: ta.has-hover ? Theme.fill : transparent;
    animate background { duration: 140ms; }
    transform-scale: ta.pressed ? 0.9 : 1;
    animate transform-scale { duration: 220ms; easing: ease-out-back; }
    Icon {
        d: root.icon;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hovered: ta.has-hover;
        below: root.tip-below;
        host-w: root.width;
        host-h: root.height;
    }
}

/// On/off switch with a springy knob.
export component Switch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: checked ? Theme.accent : Theme.fill-2;
    animate background { duration: 180ms; }
    Rectangle {
        x: root.checked ? 20px : 2px;
        y: 2px;
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: white;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000033;
        animate x { duration: 260ms; easing: ease-out-back; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

/// Apple-style pop-up button: shows the current choice with up/down chevrons; click to
/// pick from a small menu (checkmark on the current one).
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    /// Optional one-line note under each option in the menu.
    in property <[string]> notes;
    /// Option that gets a green "Best" label (-1: none).
    in property <int> best: -1;
    in property <length> menu-width: notes.length > 0 ? 250px : 180px;
    callback picked(int);
    height: 28px;
    width: row.preferred-width;
    border-radius: 7px;
    background: ta.has-hover || ta.pressed ? Theme.fill-hover : Theme.fill;
    animate background { duration: 120ms; }
    transform-scale: ta.pressed ? 0.96 : 1;
    animate transform-scale { duration: 220ms; easing: ease-out-back; }
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.options[root.index];
            font-size: 13px;
            font-weight: 500;
            color: Theme.label;
            vertical-alignment: center;
        }
        Icon {
            d: "M8.5 10L12 6.5L15.5 10M8.5 14L12 17.5L15.5 14";
            size: 15px;
            y: (parent.height - self.height) / 2;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        // Opens over the button, right-aligned, like a macOS pop-up menu.
        x: root.width - root.menu-width;
        y: -4px;
        width: root.menu-width;
        Rectangle {
            property <bool> on;
            Timer {
                interval: 16ms;
                running: !parent.on;
                triggered => { parent.on = true; }
            }
            border-radius: 10px;
            background: Theme.pop;
            border-width: 1px;
            border-color: Theme.pop-border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 5px;
            drop-shadow-color: Theme.shadow;
            opacity: self.on ? 1 : 0;
            animate opacity { duration: 120ms; }
            transform-origin: { x: self.width, y: 0 };
            transform-scale: self.on || !Fx.rich ? 1 : 0.95;
            animate transform-scale { duration: 220ms; easing: ease-out-back; }
            VerticalLayout {
                padding: 4px;
                for opt[i] in root.options: opt-row := Rectangle {
                    property <string> note: i < root.notes.length ? root.notes[i] : "";
                    height: self.note != "" ? 44px : 28px;
                    border-radius: 6px;
                    background: item.has-hover ? Theme.accent : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 6px;
                        Icon {
                            d: Icons.check;
                            size: 14px;
                            y: (parent.height - self.height) / 2;
                            color: item.has-hover ? white : Theme.label;
                            opacity: i == root.index ? 1 : 0;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: opt;
                                    font-size: 13px;
                                    font-weight: opt-row.note != "" ? 600 : 400;
                                    color: item.has-hover ? white : Theme.label;
                                    vertical-alignment: center;
                                }
                                // Green outlined "Best" label.
                                if i == root.best: Rectangle {
                                    width: best-text.preferred-width + 10px;
                                    height: 16px;
                                    y: 1px;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: item.has-hover ? white : Theme.ok;
                                    best-text := Text {
                                        text: "Best";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: item.has-hover ? white : Theme.ok;
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            if opt-row.note != "": Text {
                                text: opt-row.note;
                                font-size: 11px;
                                color: item.has-hover ? #ffffffd9 : Theme.label-2;
                            }
                        }
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.picked(i); }
                    }
                }
            }
        }
    }
}

/// Segmented control: one of a few options, with a sliding thumb.
export component Seg inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    callback picked(int);
    height: 34px;
    border-radius: 10px;
    background: Theme.fill;
    property <length> w: (self.width - 4px) / Math.max(1, options.length);
    Rectangle {
        x: 2px + root.w * root.index;
        y: 2px;
        width: root.w;
        height: root.height - 4px;
        border-radius: 8px;
        background: Theme.is-dark ? #636366 : #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000024;
        animate x { duration: 280ms; easing: ease-out-back; }
    }
    for opt[i] in root.options: Rectangle {
        x: 2px + root.w * i;
        y: 2px;
        width: root.w;
        height: root.height - 4px;
        Text {
            text: opt;
            font-size: 13px;
            font-weight: i == root.index ? 600 : 500;
            color: Theme.label;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(i); }
        }
    }
}

/// Fades content in and, with full effects, slides it up into place when it appears.
export component Appear inherits Rectangle {
    property <bool> on;
    opacity: on ? 1 : 0;
    animate opacity { duration: 220ms; easing: ease-out; }
    Timer {
        interval: 16ms;
        running: !root.on;
        triggered => { root.on = true; }
    }
    Rectangle {
        y: root.on || !Fx.rich ? 0 : 8px;
        animate y { duration: Fx.rich ? 340ms : 80ms; easing: Fx.rich ? ease-out : ease-out; }
        @children
    }
}

/// Keyboard key chip, e.g. Ctrl.
export component Kbd inherits Rectangle {
    in property <string> text;
    height: 20px;
    border-radius: 6px;
    background: Theme.fill;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: Theme.label-2;
            vertical-alignment: center;
        }
    }
}
