// The signature stage: dashed drop zone, the blob with a face, the hydraulic press that
// squeezes it with real progress, and the little burst when a file is done.
// Slow ambient motion runs on the flyout's shared timer while the stage is visible.

import { Theme, Fx } from "theme.slint";

export enum Mood { idle, hungry, worried, busy, happy }

/// A face part drawn in "face units" (the face is 52×28 units) and scaled by `k`.
component Mark inherits Path {
    in property <float> k: 1;
    in property <float> ux;
    in property <float> uy;
    in property <float> bw;
    in property <float> bh;
    in property <bool> filled;
    in property <float> line: 2.2;
    x: (ux - 2) * k * 1px;
    y: (uy - 2) * k * 1px;
    width: (bw + 4) * k * 1px;
    height: (bh + 4) * k * 1px;
    viewbox-x: -2;
    viewbox-y: -2;
    viewbox-width: bw + 4;
    viewbox-height: bh + 4;
    fill: filled ? Theme.face : transparent;
    stroke: filled ? transparent : Theme.face;
    stroke-width: line * k * 1px;
    stroke-line-cap: round;
}

/// The mascot. Centered on (cx, cy) of its parent; size follows scale and squeeze.
/// With full effects (Fx.rich) it breathes, squishes when clicked and hops when done.
export component Blob inherits Rectangle {
    in property <Mood> mood;
    in property <float> s: 1;
    in property <float> c: 0;
    in property <bool> swell;
    in property <bool> ambient-active;
    in property <float> ambient-turn;
    in property <float> look-x;
    in property <float> look-y;
    in property <length> cx;
    in property <length> cy;
    /// Bump this to make the blob hop (done).
    in property <int> hop;
    /// Bump this to make the blob squish (a file landed).
    in property <int> chomp;
    /// Press and hold works (off while the blob is faded out behind other things).
    in property <bool> touchable: true;

    property <float> grow: swell ? 1.08 : 1;
    animate grow { duration: 260ms; easing: ease-out-back; }
    // Five 3.6-second breaths per 18-second turn.
    property <float> breath: Fx.rich ? (1 - Math.cos(root.ambient-turn * 1800deg)) / 2 : 0;
    // Squish (click or chomp) and hop (done): quick in, springy out.
    property <bool> squished;
    property <float> squish;
    /// Pressed and held: squashes flat and stays there, springs back on release.
    property <bool> held: touch.pressed && root.touchable;
    property <float> press;
    property <bool> hopping;
    property <length> lift;
    states [
        pressing when root.held: {
            press: 1;
            in {
                animate press { duration: 160ms; easing: ease-out; }
            }
            out {
                animate press { duration: 700ms; easing: ease-out-elastic; }
            }
        }
        squashed when root.squished: {
            squish: 1;
            in {
                animate squish { duration: 90ms; easing: ease-out; }
            }
            out {
                animate squish { duration: 650ms; easing: ease-out-elastic; }
            }
        }
        up when root.hopping: {
            lift: -18px * root.s;
            in {
                animate lift { duration: 170ms; easing: ease-out; }
            }
            out {
                animate lift { duration: 560ms; easing: ease-out-bounce; }
            }
        }
    ]
    changed hop => {
        if (Fx.rich) {
            root.hopping = true;
            root.squished = true;
        }
    }
    changed chomp => {
        if (Fx.rich) {
            root.squished = true;
        }
    }
    Timer {
        interval: 150ms;
        running: root.squished || root.hopping;
        triggered => {
            root.squished = false;
            root.hopping = false;
        }
    }

    // Squish: an even little bounce (both axes), not a stretch. Holding squashes it flat.
    property <float> sx: s * grow * (1 + 0.2 * c) * (1 + 0.02 * breath - 0.08 * squish + 0.16 * press);
    property <float> sy: s * grow * (1 - 0.5 * c) * (1 - 0.015 * breath - 0.08 * squish - 0.24 * press);
    property <float> k: s * grow;
    property <bool> blink;

    width: 132px * sx;
    height: 116px * sy;
    x: cx - self.width / 2;
    // Breathing and squish keep the bottom on the floor.
    y: cy - 58px * s * grow * (1 - 0.5 * c) + 116px * s * grow * (1 - 0.5 * c) - self.height + lift;

    // Blink every few seconds (a timer, not a frame loop).
    Timer {
        interval: root.blink ? 110ms : 5400ms;
        running: Fx.rich && root.ambient-active && root.mood != Mood.happy;
        triggered => { root.blink = !root.blink; }
    }

    // Press and hold: squashed with a scrunched face until let go.
    touch := TouchArea {
        enabled: root.touchable;
    }

    // Soft contact shadow.
    Image {
        x: parent.width * 0.18;
        y: parent.height - 6px * root.k;
        width: parent.width * 0.64;
        height: 12px * root.k;
        source: @image-url("blob-shadow.png");
        image-fit: fill;
    }

    // Body: gradient and inner light are pre-drawn (tools/art.py). With full effects it
    // slowly turns (the uneven shape seems to morph) and wobbles when worried.
    property <bool> wob;
    property <float> wobble;
    states [
        wobbling when root.wob: {
            wobble: 1;
            in {
                animate wobble { duration: 110ms; easing: ease-out; }
            }
            out {
                animate wobble { duration: 900ms; easing: ease-out-elastic; }
            }
        }
    ]
    Timer {
        interval: root.wob ? 110ms : 2600ms;
        running: Fx.rich && root.ambient-active && root.mood == Mood.worried;
        triggered => { root.wob = !root.wob; }
    }
    // Holding squashes the turning body along the screen, not along its own turn: with
    // full effects the body keeps its unsquashed size and is scaled after it is rotated.
    // (CPU drawing doesn't turn it, so its size alone does the squash there.)
    property <float> hx: Fx.rich ? 1 + 0.16 * press : 1;
    property <float> hy: Fx.rich ? 1 - 0.24 * press : 1;
    body := Rectangle {
        width: root.width / root.hx;
        height: root.height / root.hy;
        x: (root.width - self.width) / 2;
        y: root.height - self.height;
        transform-origin: { x: self.width / 2, y: self.height };
        transform-scale-x: root.hx;
        transform-scale-y: root.hy;
        Image {
            width: parent.width;
            height: parent.height;
            source: Theme.style == 1
                ? (Theme.is-dark ? @image-url("blob-discord-dark.png") : @image-url("blob-discord-light.png"))
                : (Theme.is-dark ? @image-url("blob-dark.png") : @image-url("blob-light.png"));
            image-fit: fill;
            transform-rotation: (Fx.rich ? root.ambient-turn * 360deg : 0deg) - root.wobble * 5deg;
        }
        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("blob-gloss.png");
            image-fit: fill;
        }
    }

    // Face: 52×28 units, follows the pointer a little.
    face := Rectangle {
        property <float> k: root.k;
        // Rounded-rectangle eyes for most moods.
        property <bool> plain-eyes: !root.held && root.mood != Mood.busy && root.mood != Mood.happy;
        property <float> ew: root.mood == Mood.hungry ? 9 : 8;
        property <float> eh: (root.mood == Mood.hungry ? 15 : root.mood == Mood.worried ? 10 : 13) * (root.blink ? 0.12 : 1);
        property <float> ey: root.mood == Mood.worried ? 3 : 0;
        property <length> dx: root.look-x * 4.5px * k;
        property <length> dy: root.look-y * 3px * k;
        animate dx, dy { duration: 140ms; easing: ease-out; }
        x: (parent.width - 52px * k) / 2 + dx;
        y: parent.height * 0.44 - 4px * k * root.c + 2px * k * root.press + dy;
        width: 52px * k;
        height: 28px * k;

        if face.plain-eyes: Rectangle {
            x: 9px * face.k;
            y: (face.ey + (13 - face.eh) * 0.6) * face.k * 1px;
            width: face.ew * face.k * 1px;
            height: face.eh * face.k * 1px;
            border-radius: Math.min(self.width, self.height) / 2;
            background: Theme.face;
            animate height, y { duration: 70ms; }
        }
        if face.plain-eyes: Rectangle {
            x: face.width - (9 + face.ew) * face.k * 1px;
            y: (face.ey + (13 - face.eh) * 0.6) * face.k * 1px;
            width: face.ew * face.k * 1px;
            height: face.eh * face.k * 1px;
            border-radius: Math.min(self.width, self.height) / 2;
            background: Theme.face;
            animate height, y { duration: 70ms; }
        }

        // Held: scrunched > < eyes and a wobbly mouth.
        if root.held: Mark {
            k: face.k; ux: 8; uy: 3; bw: 10; bh: 9; line: 3;
            commands: "M0 0L10 4.5L0 9";
        }
        if root.held: Mark {
            k: face.k; ux: 34; uy: 3; bw: 10; bh: 9; line: 3;
            commands: "M10 0L0 4.5L10 9";
        }
        if root.held: Mark {
            k: face.k; ux: 17; uy: 19; bw: 18; bh: 4; line: 2.4;
            commands: "M0 2C1.5 0 3 0 4.5 2C6 4 7.5 4 9 2C10.5 0 12 0 13.5 2C15 4 16.5 4 18 2";
        }
        // Busy: squinting, more as the press closes.
        if !root.held && root.mood == Mood.busy: Mark {
            k: face.k; ux: 8; uy: 4; bw: 11; bh: 3 + root.c * 3; line: 3;
            commands: "M0 0L11 " + (3 + root.c * 3);
        }
        if !root.held && root.mood == Mood.busy: Mark {
            k: face.k; ux: 33; uy: 4; bw: 11; bh: 3 + root.c * 3; line: 3;
            commands: "M0 " + (3 + root.c * 3) + "L11 0";
        }
        if !root.held && root.mood == Mood.busy: Mark {
            k: face.k; ux: 22.5; uy: 17; bw: 7; bh: 7; line: 2;
            commands: "M0 3.5A3.5 3.5 0 1 0 7 3.5A3.5 3.5 0 1 0 0 3.5Z";
        }

        // Happy: arched eyes and a big smile.
        if !root.held && root.mood == Mood.happy: Mark {
            k: face.k; ux: 8; uy: 3; bw: 11; bh: 7; line: 2.4;
            commands: "M0 7A5.5 6 0 0 1 11 7";
        }
        if !root.held && root.mood == Mood.happy: Mark {
            k: face.k; ux: 33; uy: 3; bw: 11; bh: 7; line: 2.4;
            commands: "M0 7A5.5 6 0 0 1 11 7";
        }
        if !root.held && root.mood == Mood.happy: Mark {
            k: face.k; ux: 17; uy: 18; bw: 18; bh: 9; filled: true;
            commands: "M0 0L18 0A9 9 0 0 1 0 0Z";
        }

        // Mouths for the other moods.
        if !root.held && root.mood == Mood.idle: Mark {
            k: face.k; ux: 20; uy: 18; bw: 12; bh: 6;
            commands: "M0 0A6 6 0 0 0 12 0";
        }
        if !root.held && root.mood == Mood.hungry: Mark {
            k: face.k; ux: 19.5; uy: 17; bw: 13; bh: 13; filled: true;
            commands: "M0 6.5A6.5 6.5 0 1 0 13 6.5A6.5 6.5 0 1 0 0 6.5Z";
        }
        if !root.held && root.mood == Mood.worried: Mark {
            k: face.k; ux: 20; uy: 21; bw: 12; bh: 5;
            commands: "M0 5A6 5 0 0 1 12 5";
        }
    }
}

/// Dashed drop outline. The dashes come from Rust (`dash-path`), computed for this size.
export component DropZone inherits Rectangle {
    in property <bool> active;
    in property <bool> visible-dash;
    in property <string> dash-path;
    border-radius: 28px;
    background: active ? Theme.accent-soft : transparent;
    opacity: visible-dash || active ? 1 : 0;
    animate background, opacity { duration: 160ms; }
    transform-scale: active ? 1.015 : visible-dash ? 1 : 0.94;
    animate transform-scale { duration: 280ms; easing: ease-out-back; }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: parent.width / 1px;
        viewbox-height: parent.height / 1px;
        commands: root.dash-path;
        stroke: root.active ? Theme.accent-text : Theme.label-2.transparentize(0.5);
        stroke-width: root.active ? 2.2px : 1.6px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

/// The hydraulic press. `c` (0…1) is the smoothed squeeze; the plates touch the blob.
/// `intro` (0…1) brings the heads in from off-screen. Heads are pre-drawn (tools/art.py).
export component Press inherits Rectangle {
    in property <float> c;
    in property <float> intro;
    property <length> d: 150px + ((58 * 0.85 * (1 - 0.5 * c) + 1.5) * 1px - 150px) * intro;
    clip: true;
    Image {
        x: (parent.width - 124px) / 2;
        y: parent.height / 2 - root.d - 252px;
        width: 124px;
        height: 252px;
        source: @image-url("press-top.png");
        image-fit: fill;
    }
    Image {
        x: (parent.width - 124px) / 2;
        y: parent.height / 2 + root.d;
        width: 124px;
        height: 252px;
        source: @image-url("press-bottom.png");
        image-fit: fill;
    }
}

/// Eight dots flying out from the blob once, when a file is done.
export component Sparks inherits Rectangle {
    property <float> t: 0;
    animate t { duration: 420ms; easing: ease-out; }
    Timer {
        interval: 60ms;
        running: root.t == 0;
        triggered => { root.t = 1; }
    }
    for i in 8: Rectangle {
        property <angle> a: i * 45deg;
        property <length> r: 56px + 40px * root.t;
        property <float> sz: 1 - 0.8 * root.t;
        x: parent.width / 2 + self.r * Math.sin(self.a) - 3px * self.sz;
        y: parent.height / 2 - self.r * Math.cos(self.a) - 3px * self.sz;
        width: 6px * self.sz;
        height: 6px * self.sz;
        border-radius: self.width / 2;
        background: Math.mod(i, 2) == 0 ? Theme.accent : Theme.pouch-b;
        opacity: root.t == 0 || root.t == 1 ? 0 : 1 - root.t;
    }
}
