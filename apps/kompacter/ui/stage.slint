// The signature stage: dashed drop zone, the blob with a face, the hydraulic press that
// squeezes it with real progress, and the little burst when a file is done.
// Everything animates only when something changes, so an idle window costs no CPU.

import { Theme } from "theme.slint";

export enum Mood { idle, hungry, worried, busy, happy }

/// A face part drawn in "face units" (the face is 52×28 units) and scaled by `k`.
component Mark inherits Path {
    in property <float> k: 1;
    in property <float> ux;
    in property <float> uy;
    in property <float> bw;
    in property <float> bh;
    in property <bool> filled;
    in property <float> line: 2.2;
    x: (ux - 2) * k * 1px;
    y: (uy - 2) * k * 1px;
    width: (bw + 4) * k * 1px;
    height: (bh + 4) * k * 1px;
    viewbox-x: -2;
    viewbox-y: -2;
    viewbox-width: bw + 4;
    viewbox-height: bh + 4;
    fill: filled ? Theme.face : transparent;
    stroke: filled ? transparent : Theme.face;
    stroke-width: line * k * 1px;
    stroke-line-cap: round;
}

/// The mascot. Centered on (cx, cy) of its parent; size follows scale and squeeze.
export component Blob inherits Rectangle {
    in property <Mood> mood;
    in property <float> s: 1;
    in property <float> c: 0;
    in property <bool> swell;
    in property <float> look-x;
    in property <float> look-y;
    in property <length> cx;
    in property <length> cy;

    property <float> grow: swell ? 1.08 : 1;
    property <float> sx: s * grow * (1 + 0.2 * c);
    property <float> sy: s * grow * (1 - 0.5 * c);
    property <float> k: s * grow;
    property <bool> blink;

    width: 132px * sx;
    height: 116px * sy;
    x: cx - self.width / 2;
    y: cy - self.height / 2;
    animate width, height { duration: 240ms; easing: ease-out; }

    // Blink every few seconds (a timer, not a frame loop).
    Timer {
        interval: root.blink ? 110ms : 5400ms;
        running: root.mood != Mood.busy && root.mood != Mood.happy;
        triggered => { root.blink = !root.blink; }
    }

    // Soft contact shadow.
    Image {
        x: parent.width * 0.18;
        y: parent.height - 6px * root.k;
        width: parent.width * 0.64;
        height: 12px * root.k;
        source: @image-url("blob-shadow.png");
        image-fit: fill;
    }

    // Body: gradient, inner light and gloss are pre-drawn (tools/blob.py), because the
    // CPU renderer can only draw gradients as plain rectangles.
    Image {
        width: parent.width;
        height: parent.height;
        source: Theme.dark ? @image-url("blob-dark.png") : @image-url("blob-light.png");
        image-fit: fill;
    }

    // Face: 52×28 units, follows the pointer a little.
    face := Rectangle {
        property <float> k: root.k;
        // Rounded-rectangle eyes for most moods.
        property <bool> plain-eyes: root.mood != Mood.busy && root.mood != Mood.happy;
        property <float> ew: root.mood == Mood.hungry ? 9 : 8;
        property <float> eh: (root.mood == Mood.hungry ? 15 : root.mood == Mood.worried ? 10 : 13) * (root.blink ? 0.12 : 1);
        property <float> ey: root.mood == Mood.worried ? 3 : 0;
        x: (parent.width - 52px * k) / 2 + root.look-x * 3.5px;
        y: parent.height * 0.44 - 4px * k * root.c + root.look-y * 2.4px;
        width: 52px * k;
        height: 28px * k;
        animate x, y { duration: 180ms; easing: ease-out; }

        if face.plain-eyes: Rectangle {
            x: 9px * face.k;
            y: (face.ey + (13 - face.eh) * 0.6) * face.k * 1px;
            width: face.ew * face.k * 1px;
            height: face.eh * face.k * 1px;
            border-radius: Math.min(self.width, self.height) / 2;
            background: Theme.face;
            animate height, y { duration: 70ms; }
        }
        if face.plain-eyes: Rectangle {
            x: face.width - (9 + face.ew) * face.k * 1px;
            y: (face.ey + (13 - face.eh) * 0.6) * face.k * 1px;
            width: face.ew * face.k * 1px;
            height: face.eh * face.k * 1px;
            border-radius: Math.min(self.width, self.height) / 2;
            background: Theme.face;
            animate height, y { duration: 70ms; }
        }

        // Busy: squinting, more as the press closes.
        if root.mood == Mood.busy: Mark {
            k: face.k; ux: 8; uy: 4; bw: 11; bh: 3 + root.c * 3; line: 3;
            commands: "M0 0L11 " + (3 + root.c * 3);
        }
        if root.mood == Mood.busy: Mark {
            k: face.k; ux: 33; uy: 4; bw: 11; bh: 3 + root.c * 3; line: 3;
            commands: "M0 " + (3 + root.c * 3) + "L11 0";
        }
        if root.mood == Mood.busy: Mark {
            k: face.k; ux: 22.5; uy: 17; bw: 7; bh: 7; line: 2;
            commands: "M0 3.5A3.5 3.5 0 1 0 7 3.5A3.5 3.5 0 1 0 0 3.5Z";
        }

        // Happy: arched eyes and a big smile.
        if root.mood == Mood.happy: Mark {
            k: face.k; ux: 8; uy: 3; bw: 11; bh: 7; line: 2.4;
            commands: "M0 7A5.5 6 0 0 1 11 7";
        }
        if root.mood == Mood.happy: Mark {
            k: face.k; ux: 33; uy: 3; bw: 11; bh: 7; line: 2.4;
            commands: "M0 7A5.5 6 0 0 1 11 7";
        }
        if root.mood == Mood.happy: Mark {
            k: face.k; ux: 17; uy: 18; bw: 18; bh: 9; filled: true;
            commands: "M0 0L18 0A9 9 0 0 1 0 0Z";
        }

        // Mouths for the other moods.
        if root.mood == Mood.idle: Mark {
            k: face.k; ux: 20; uy: 18; bw: 12; bh: 6;
            commands: "M0 0A6 6 0 0 0 12 0";
        }
        if root.mood == Mood.hungry: Mark {
            k: face.k; ux: 19.5; uy: 17; bw: 13; bh: 13; filled: true;
            commands: "M0 6.5A6.5 6.5 0 1 0 13 6.5A6.5 6.5 0 1 0 0 6.5Z";
        }
        if root.mood == Mood.worried: Mark {
            k: face.k; ux: 20; uy: 21; bw: 12; bh: 5;
            commands: "M0 5A6 5 0 0 1 12 5";
        }
    }
}

/// Dashed drop outline. The dashes come from Rust (`dash-path`), computed for this size.
export component DropZone inherits Rectangle {
    in property <bool> active;
    in property <bool> visible-dash;
    in property <string> dash-path;
    border-radius: 28px;
    background: active ? Theme.accent-soft : transparent;
    opacity: visible-dash || active ? 1 : 0;
    animate background, opacity { duration: 160ms; }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: parent.width / 1px;
        viewbox-height: parent.height / 1px;
        commands: root.dash-path;
        stroke: root.active ? Theme.accent-text : Theme.label-2.transparentize(0.62);
        stroke-width: root.active ? 2.2px : 1.5px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

/// One press head: pole → hazard collar → trapezoid → plate (124 wide, 252 tall).
component Head inherits Rectangle {
    in property <bool> top;
    width: 124px;
    height: 252px;
    // Pole.
    Rectangle {
        x: (124px - 33.5px) / 2;
        y: root.top ? 0 : 52px;
        width: 33.5px;
        height: 200px;
        background: Theme.metal;
    }
    // Hazard collar (yellow and black stripes).
    Rectangle {
        x: (124px - 43.4px) / 2;
        y: root.top ? 200px : 38px;
        width: 43.4px;
        height: 14px;
        border-radius: 3px;
        background: #f5c400;
        clip: true;
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 43.4;
            viewbox-height: 14;
            commands: "M-14 14L-9 14L5 0L0 0ZM-4 14L1 14L15 0L10 0ZM6 14L11 14L25 0L20 0ZM16 14L21 14L35 0L30 0ZM26 14L31 14L45 0L40 0ZM36 14L41 14L55 0L50 0Z";
            fill: #141414;
        }
    }
    // Trapezoid: a metal block with its outer corners cut away.
    Rectangle {
        x: (124px - 101.7px) / 2;
        y: root.top ? 214px : 12px;
        width: 101.7px;
        height: 26px;
        background: Theme.metal;
        Rectangle {
            background: root.top ? @linear-gradient(180deg, #ffffff47 0%, #00000029 100%) : @linear-gradient(0deg, #ffffff47 0%, #00000029 100%);
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 101.7;
            viewbox-height: 26;
            commands: root.top ? "M0 0L11.8 0L0 26ZM89.9 0L101.7 0L101.7 26Z" : "M0 0L11.8 26L0 26ZM101.7 0L89.9 26L101.7 26Z";
            fill: Theme.bg;
        }
    }
    // Plate.
    Rectangle {
        y: root.top ? 240px : 0;
        width: 124px;
        height: 12px;
        border-radius: 2px;
        background: Theme.metal;
        Rectangle {
            y: 0;
            height: 1px;
            background: #ffffffcc;
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: #00000047;
        }
    }
}

/// The hydraulic press. `c` (0…1) is the smoothed squeeze; the plates touch the blob.
export component Press inherits Rectangle {
    in property <float> c;
    in property <bool> active;
    property <length> d: active ? (58 * 0.85 * (1 - 0.5 * c) + 1.5) * 1px : 150px;
    animate d { duration: 260ms; easing: ease-out; }
    clip: true;
    Head {
        top: true;
        x: (parent.width - self.width) / 2;
        y: parent.height / 2 - root.d - self.height;
    }
    Head {
        top: false;
        x: (parent.width - self.width) / 2;
        y: parent.height / 2 + root.d;
    }
}

/// Eight dots flying out from the blob once, when a file is done.
export component Sparks inherits Rectangle {
    property <float> t: 0;
    animate t { duration: 420ms; easing: ease-out; }
    Timer {
        interval: 60ms;
        running: root.t == 0;
        triggered => { root.t = 1; }
    }
    for i in 8: Rectangle {
        property <angle> a: i * 45deg;
        property <length> r: 56px + 40px * root.t;
        property <float> sz: 1 - 0.8 * root.t;
        x: parent.width / 2 + self.r * Math.sin(self.a) - 3px * self.sz;
        y: parent.height / 2 - self.r * Math.cos(self.a) - 3px * self.sz;
        width: 6px * self.sz;
        height: 6px * self.sz;
        border-radius: self.width / 2;
        background: Math.mod(i, 2) == 0 ? Theme.accent : Theme.pouch-b;
        opacity: root.t == 0 || root.t == 1 ? 0 : 1 - root.t;
    }
}
